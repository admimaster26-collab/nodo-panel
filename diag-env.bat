@echo off
chcp 65001 >nul
title Diagnostico .env - NODO OPERATIVO
powershell -NoProfile -ExecutionPolicy Bypass -Command "$d=Join-Path $env:APPDATA 'nodo-operativo'; Write-Host '=============================================='; Write-Host '  DIAGNOSTICO .env  -  NODO OPERATIVO'; Write-Host '=============================================='; Write-Host ('Carpeta userData: ' + $d); Write-Host ''; if(-not (Test-Path -LiteralPath $d)){ Write-Host '[X] La carpeta NO existe. Abri el NODO una vez y reintenta.'; Write-Host ''; Read-Host 'Enter para salir'; exit }; Write-Host '--- Archivos .env* en esa carpeta ---'; $found=$false; Get-ChildItem -LiteralPath $d -Force -Filter '.env*' | ForEach-Object { $found=$true; Write-Host ('   ' + $_.Name + '   (' + $_.Length + ' bytes)') }; if(-not $found){ Write-Host '   (ninguno)' }; Write-Host ''; $p=Join-Path $d '.env'; if(-not (Test-Path -LiteralPath $p)){ Write-Host '[X] NO existe un archivo llamado EXACTAMENTE .env'; Write-Host '    (probablemente quedo como .env.txt -> renombralo a .env)'; Write-Host ''; Read-Host 'Enter para salir'; exit }; $b=[System.IO.File]::ReadAllBytes($p); if($b.Length -ge 3 -and $b[0] -eq 0xEF -and $b[1] -eq 0xBB -and $b[2] -eq 0xBF){ Write-Host '[!] Tiene BOM (UTF-8 con BOM). Reguardalo como UTF-8 SIN BOM o ANSI.' }; if($b.Length -ge 2 -and (($b[0] -eq 0xFF -and $b[1] -eq 0xFE) -or ($b[0] -eq 0xFE -and $b[1] -eq 0xFF))){ Write-Host '[X] Esta en UTF-16/Unicode. La app NO lo lee. Reguardalo como UTF-8 SIN BOM o ANSI.' }; Write-Host '--- Lineas del .env (valores sensibles ocultos) ---'; $lines=Get-Content -LiteralPath $p; $nlin=0; foreach($ln in $lines){ $t=$ln.Trim(); if($t -eq '' -or $t.StartsWith('#')){ continue }; $nlin++; if($t -match '^\s*([^=]+?)\s*=\s*(.*)$'){ $k=$Matches[1].Trim(); $v=$Matches[2].Trim(); if($k -match 'SECRET|PASS|KEY|TOKEN'){ $v='********' }; Write-Host ('   ' + $k + ' = ' + $v) } else { Write-Host ('   [?] linea sin = -> ' + $t) } }; if($nlin -eq 0){ Write-Host '   (vacio)' }; Write-Host ''; $txt=Get-Content -LiteralPath $p -Raw; $mp=[regex]::Match($txt,'(?im)^\s*AGENT_PLATFORM\s*=\s*(\S+)'); Write-Host '--- CHEQUEOS ---'; if($mp.Success){ $val=$mp.Groups[1].Value.Trim(); if($val.ToLower() -eq 'bet300'){ Write-Host ('[OK] AGENT_PLATFORM = ' + $val + '  -> deberia abrir BET300') } else { Write-Host ('[!] AGENT_PLATFORM = ' + $val + '  (para BET300 tiene que decir exactamente: bet300)') } } else { Write-Host '[X] NO encontre la linea AGENT_PLATFORM= en el .env (por eso sale casinodrex)' }; $ms=[regex]::Match($txt,'(?im)^\s*PANEL_DATA_SECRET\s*=\s*(\S+)'); if($ms.Success){ Write-Host '[OK] PANEL_DATA_SECRET presente' } else { Write-Host '[!] PANEL_DATA_SECRET ausente/vacio' }; Write-Host ''; Read-Host 'Enter para salir'"
