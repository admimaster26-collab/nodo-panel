async function consultarEstadoSolicitud(mostrarMensaje=true){
  const sid=solicitudIdValido();
  if(!sid){if(mostrarMensaje)toast("No hay una solicitud válida para consultar.");return null;}
  const chatIdNum=/^\d+$/.test(String(state.chatId||""))?Number(state.chatId):null;
  const res=await rpc("landing_estado_solicitud_segura",{
    p_solicitud_id:sid,
    p_chat_id:chatIdNum,
    p_chat_token:state.chatToken||""
  });
  if(res.error){if(mostrarMensaje)toast("No pude consultar el estado ahora.");return null;}
  const d=normalize(res.data)||res.data||{};
  if(d.ok===false){setEstadoLive("⏳ En verificación");return "PENDIENTE";}
  const estado=estadoNormalizado(d.estado||d.status||d.estado_solicitud);
  // Motivo del rechazo: la RPC landing_estado_solicitud_segura lo devuelve en `mensaje` cuando el
  // estado es final-rechazado (lo carga el operador al rechazar y queda en landing_solicitudes.metadata).
  // Ignoramos el "OK" que la RPC devuelve en los casos normales (no es un motivo).
  const _motivoMsg=(d.mensaje && String(d.mensaje).trim().toUpperCase()!=="OK") ? String(d.mensaje).trim() : "";
  const obs=String(d.obs||d.observacion||d.motivo||d.razon||_motivoMsg||"").trim();
  if(esEstadoFinalAprobado(estado)){
    if(esConfirmacionDemasiadoTemprana()){setEstadoLive("⏳ En verificación");return "PENDIENTE";}
    limpiarPendienteAprobado(obs);
    return estado;
  }
  if(esEstadoFinalRechazado(estado)){
    rechazadoStreak++;
    if(rechazadoStreak < 3){setEstadoLive("⏳ En verificación");return "PENDIENTE";}
    stopEstadoPoll();
    rechazadoStreak=0;
    const eraRetiro = String(state.pendingTipo||"").toUpperCase()==="RETIRO";
    olvidarSolicitud(false);
    // Retiro rechazado/cancelado por el operador → no se efectuó → liberar el cooldown de 24h.
    if(eraRetiro){ try{localStorage.removeItem(_retiroKey());}catch(_e){} }
    const s=$("screenEstado");
    if(s)s.innerHTML=`<div class="screen-title">Estado</div>
      <div class="estado-card bad">
        <div class="estado-ico">⚠️</div>
        <div class="estado-h">Tu solicitud no pudo procesarse</div>
        ${obs?`<div class="estado-tx">${escMsg(obs)}</div>`:`<div class="estado-tx">Escribinos por el chat y un operador te ayuda.</div>`}
        <div class="estado-actions"><button class="action-btn" onclick="goChat()">💬 Consultar</button><button class="action-btn secondary-btn" onclick="goCarga()">Nueva carga</button></div>
      </div>`;
    try{ pintarHistorialUsuario(); }catch(_e){}   // el rechazo (con su motivo) ya figura en el historial
    renderHome();
    if($("widget")?.classList.contains("open"))showScreen("estado");
    return estado;
  }
  rechazadoStreak=0;
  const _esRetiroPend = String(state.pendingTipo||"").toUpperCase()==="RETIRO";
  if(_esRetiroPend) cargarProgresoRetiro().catch(()=>{});
  // EN_PROCESO: SOLO para RETIRO es "pago por partes". Para una CARGA es "acreditando" — antes se
  // pegaba la pantalla de retiro en proceso sobre una carga y confundía (bug reportado).
  if(estado==="EN_PROCESO"){
    try{ const s=$("screenEstado"); const h=s&&s.querySelector(".estado-h"); const sub=s&&s.querySelector(".estado-sub"); const tx=s&&s.querySelector(".estado-tx");
      if(_esRetiroPend){
        if(h)h.textContent="🔄 Retiro en proceso";
        if(sub)sub.textContent="Te lo estamos pagando por partes — vas a ver cada pago acá";
        if(tx)tx.textContent="Tu retiro es grande y lo abonamos por tramos. Cada transferencia aparece abajo y te avisamos.";
      }else{
        if(h)h.textContent="⏳ Procesando tu carga";
        if(sub)sub.textContent="Estamos acreditando tus fichas";
        if(tx)tx.textContent="Ya estamos procesando tu carga. En un momento vas a ver tus fichas acreditadas.";
      }
    }catch(_e){}
  }
  setEstadoLive(estado==="EN_PROCESO"?(_esRetiroPend?"💸 Te estamos pagando por partes":"⏳ Acreditando tu carga"):"⏳ En verificación");
  return estado||"PENDIENTE";
}

// Retiros parciales (punto 3): trae total/pagado/pagos y pinta la barra + la lista en el estado.
// Muestra un toast in-app cuando sube lo pagado; el aviso de fondo lo dispara el panel por push.
async function cargarProgresoRetiro(){
  const sid=solicitudIdValido(); if(!sid) return;
  const box=$("retiroProgreso"); if(!box) return;
  const res=await rpc("landing_retiro_progreso",{p_solicitud_id: sid, p_chat_id:null, p_chat_token:state.chatToken||""});
  if(res.error) return;
  const prog=normalize(res.data)||res.data||{};
  if(!prog || prog.ok===false) return;
  const total=Number(prog.total||0), pagado=Number(prog.pagado||0);
  let pct=Number(prog.pct||0); if(pct<0)pct=0; if(pct>100)pct=100;
  // Monto ajustado por el operador, con su motivo (D-88). Se muestra aunque todavía no haya pagos:
  // es justo cuando el jugador ve un número distinto del que pidió y necesita saber por qué.
  let aj=prog.ajuste; if(typeof aj==="string"){ try{aj=JSON.parse(aj);}catch(_e){aj=null;} }
  const ajusteHtml=(aj && (aj.motivo || aj.corregido))
    ? `<div class="rp-ajuste"><b>📝 Ajustamos el monto a ${_money(Number(aj.corregido||total))}</b>${aj.declarado?` <span class="rp-ajuste-de">(pediste ${_money(Number(aj.declarado))})</span>`:""}${aj.motivo?`<div class="rp-ajuste-motivo">${esc(aj.motivo)}</div>`:""}</div>`
    : "";
  if(!(total>0) || (!(pagado>0) && !ajusteHtml)){ box.innerHTML=""; return; }   // sin parciales ni ajuste → sin barra

  // Cierre a mano: el operador terminó la operación aunque quedara plata sin pagar. Sin esto
  // el portal seguía mostrando "faltan $25.000" para siempre, sin decir que ya había cerrado
  // ni por qué. La nota es obligatoria del lado del panel, así que siempre hay algo que leer.
  let cierre=prog.cierre; if(typeof cierre==="string"){ try{cierre=JSON.parse(cierre);}catch(_e){cierre=null;} }
  if(cierre && (cierre.nota || cierre.etiqueta)){
    try{ const s2=$("screenEstado"); const h=s2&&s2.querySelector(".estado-h"); if(h)h.textContent="Retiro cerrado";
         const sub=s2&&s2.querySelector(".estado-sub"); if(sub)sub.textContent="Cobraste "+_money(pagado)+" de "+_money(total); }catch(_e){}
    box.innerHTML=`<div class="rp-wrap">
      <div class="rp-top"><span>Cobrado</span><span class="rp-nums">${_money(pagado)} / ${_money(total)}</span></div>
      <div class="rp-track"><div class="rp-fill" style="width:${pct}%"></div></div>
      ${ajusteHtml}
      <div class="rp-cierre">
        <b>Este retiro se cerró.</b>
        ${cierre.etiqueta?`<div>${esc(cierre.etiqueta)}</div>`:""}
        ${cierre.nota?`<div class="rp-cierre-nota">"${esc(cierre.nota)}"</div>`:""}
      </div>
    </div>`;
    return;
  }
  try{
    const k="bet300_retiro_pagado_"+sid, last=Number(localStorage.getItem(k)||0);
    if(pagado>last){ localStorage.setItem(k,String(pagado));
      if(last>0) toast("💸 Pago parcial: +"+_money(pagado-last)+" · van "+_money(pagado)+" de "+_money(total)); }
  }catch(_e){}
  // "Te lo estamos pagando por partes" sólo si ya hubo un pago: con el monto ajustado y sin pagos
  // todavía, el cartel mentía.
  if(pagado>0){ try{ const s=$("screenEstado"); const h=s&&s.querySelector(".estado-h"); if(h)h.textContent="Retiro en proceso";
       const sub=s&&s.querySelector(".estado-sub"); if(sub)sub.textContent="Te lo estamos pagando por partes"; }catch(_e){} }
  let pagos=prog.pagos; if(typeof pagos==="string"){ try{pagos=JSON.parse(pagos);}catch(_e){pagos=[];} } if(!Array.isArray(pagos)) pagos=[];
  const lista=pagos.slice().reverse().map(p=>{
    const m=_money(Number(p.monto||0));
    let f=""; try{ f=new Date(p.fecha).toLocaleString("es-AR",{day:"2-digit",month:"2-digit",hour:"2-digit",minute:"2-digit"}); }catch(_e){}
    return `<div class="rp-item"><span class="rp-m">+${m}</span><span class="rp-f">${esc(f)}</span></div>`;
  }).join("");
  box.innerHTML=`<div class="rp-wrap">
    <div class="rp-top"><span>Pagado</span><span class="rp-nums">${_money(pagado)} / ${_money(total)}</span></div>
    <div class="rp-track"><div class="rp-fill" style="width:${pct}%"></div></div>
    <div class="rp-pct">${pct}% · faltan ${_money(Math.max(total-pagado,0))}</div>
    ${ajusteHtml}
    ${lista?`<div class="rp-list">${lista}</div>`:""}
  </div>`;
}
