// Marca los campos vacíos, lleva el primero a la vista y lo enfoca.
// Antes un formulario incompleto solo mostraba un cartel abajo que duraba 2,4 s: la persona
// veía "completá los datos" sin saber CUÁL faltaba, y en Cargar el campo podía estar fuera
// de pantalla. Devuelve true si falta algo.
function marcarFaltantes(ids){
  document.querySelectorAll("input.falta").forEach(e=>e.classList.remove("falta"));
  const faltan = ids.filter(id => !(($(id)?.value)||"").trim());
  if(!faltan.length) return false;
  faltan.forEach(id=>{
    const e=$(id); if(!e) return;
    e.classList.add("falta");
    // se limpia sola apenas empieza a escribir: la marca no debe quedar pegada
    e.addEventListener("input", ()=>e.classList.remove("falta"), {once:true});
  });
  const primero=$(faltan[0]);
  if(primero){
    try{ primero.scrollIntoView({block:"center",behavior:"smooth"}); }catch(_e){}
    try{ primero.focus({preventScroll:true}); }catch(_e){ try{primero.focus();}catch(_e2){} }
  }
  haptic(18);
  return true;
}

