      +   '<div><div style="font-weight:800;font-size:14px;color:#e8edf4">'+(esRetiro?"Retiro":"Carga")+'</div>'
      +   '<div style="font-size:11px;color:#8b95a5">'+esc(_fechaCorta(r.fecha))+'</div></div></div>'
      + '<div style="text-align:right"><div style="font-weight:900;font-size:15px;color:#e9c25c">'+_money(Number(r.monto)||0)+'</div>'+_estadoBadge(r.estado, r.cancelada_por)+'</div>'+detalle
      + (rech && r.motivo ? '<div style="width:100%;font-size:11.5px;color:#fca5a5;background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.25);border-radius:8px;padding:6px 8px;margin-top:2px">🚫 '+esc(r.motivo)+'</div>' : '')
      + '</div>';
  }).join("");
  box.innerHTML='<div style="font-size:12px;font-weight:800;color:#8b95a5;text-transform:uppercase;letter-spacing:.4px;margin:16px 2px 4px">Últimos 7 días <span style="opacity:.55;font-weight:600;text-transform:none;letter-spacing:0">'+PORTAL_VER+'</span></div>'+filas;
}

// La billetera de la solicitud, y el aviso cuando la que figura ahora en el portal es otra.
// El caso real: la persona deja el portal abierto, nosotros cambiamos la billetera activa, y
// ella manda la solicitud con la anterior. Del lado del panel eso ya se avisa; acá lo tiene
// que ver ella, que es la que sabe adónde transfirió de verdad.
function _avisoBilleteraSolicitud(){
  const dela = String(state.pendingBilletera||"").trim();
  if(!dela) return "";
  const b = state.billetera||{};
  // Se compara con el mismo criterio con el que se guardó: titular primero. Si se comparara el
  // nombre interno contra un titular, TODO parecería distinto y avisaría siempre.
  const activaTxt = String(b.titular || b.nombre_visible || b.nombre || "").trim();
  // Comparación floja: alcanza con que el nombre esté adentro, porque una guarda el alias y la
  // otra puede no traerlo.
  const norm = (v)=>String(v||"").toLowerCase().replace(/[^a-z0-9]/g,"");
  const nd = norm(dela), na = norm(activaTxt);
  const cambio = !!(nd && na && nd.indexOf(na)===-1 && na.indexOf(nd)===-1);
  return `
    <div class="bil-sol${cambio ? " cambio" : ""}">
      <div class="bil-sol-k">Transferiste a</div>
      <div class="bil-sol-v">${esc(dela)}</div>
      ${cambio ? `<div class="bil-sol-aviso">⚠ En el portal ahora figura <b>${esc(activaTxt)}</b>.
        Tu solicitud queda igual con la de arriba. Si transferiste a esta otra, avisanos por el chat.</div>` : ""}
    </div>`;
}

