// Canal de soporte/alta SIN validación: para usuarios nuevos (no están en la base) o
// que recién quieren registrarse (un pariente les pasó el link). Entran al chat directo
// y el operador los registra/vincula desde el panel. NO pelea con el cotejo.
function _persistSoporte(){
  try{
    localStorage.setItem("bet300_usuario",state.usuario);
    localStorage.setItem("bet300_telefono",state.telefono);
    localStorage.setItem("bet300_nivel_acceso","SOPORTE");
    localStorage.setItem("bet300_motivo_soporte",state.motivoSoporte);
  }catch(_e){}
}
// REGISTRO: usuario NUEVO (publicidad / derivado). Pide nombre/apodo + tel y manda al operador
// un ticket CLARO de alta nueva. No pelea con el cotejo (no tiene usuario aún).
// OJO: el bono de bienvenida NO es de "nuevos" — es para la PRIMERA carga de CUALQUIERA, y lo
// maneja la tarjeta de bono en Inicio (renderBonoBienvenidaCard). Este flujo NO lo menciona.
// Teléfono argentino: 10 números con el código de área (11 2345 6789). Se aceptan el +54, el 9 y el
// 0 de adelante, que es como se copia de WhatsApp; el 15 no, porque no se sabe dónde termina la
// característica. Alcanzaba con 6 números y llegaban pedidos con "Tel: 111234" (Carlitos, 2/11).
// Es la única regla: la usan el ingreso, el registro y el "no me acuerdo", en pantalla y en el chat.
const TEL_AYUDA="Escribí tu teléfono con código de área: 10 números, sin 0 ni 15. Ej: 11 2345 6789.";
function telefonoDiezDigitos(t){
  let d=String(t||"").replace(/\D/g,"");
  if(d.length>10&&d.startsWith("54"))d=d.slice(2);
  if(d.length>10&&d.startsWith("9"))d=d.slice(1);
  if(d.length>10&&d.startsWith("0"))d=d.slice(1);
  return d.length===10?d:"";
}
// El WhatsApp de la oficina como lo pide wa.me: 549 y los 10 números. Pasa por la misma regla, así que
// un número mal cargado (le faltan números, trae el 15) queda vacío y no se ofrece el botón: mejor sin
// botón que mandar al jugador a escribirle a otro.
function normalizarWhatsApp(t){
  const d=telefonoDiezDigitos(t);
  return d?"549"+d:"";
}
// Viene con la ruta de la oficina, pero si la ruta salió del dominio propio esa respuesta no lo trae:
// se pregunta recién cuando hace falta y una sola vez. Sin conexión no se guarda y se vuelve a probar.
async function whatsappOficina(){
  if(typeof state.whatsappOficina==="string")return state.whatsappOficina;
  const ruta=state.publicCode;
  if(!ruta)return "";
  try{
    const r=await rpc("landing_resolver_ruta_publica",{p_public_code:ruta});
    if(r.error)return "";
    const numero=normalizarWhatsApp(normalize(r.data)?.whatsapp_numero);
    if(state.publicCode===ruta)state.whatsappOficina=numero;   // si cambió de oficina en el medio, no
    return numero;
  }catch(_e){return "";}
}
function pedirRegistroCon(nombre,telefono){
