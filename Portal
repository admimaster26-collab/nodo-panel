// cargar (Juan, 2/11). Ahora se pregunta antes y, si falta validar, se lo valida primero y después
// sigue con lo que quería hacer.
const VINCULO_OPERA=["ACCESO","NUEVO","PENDIENTE"];
const VINCULO_NO_OPERA=["NO_REGISTRADO","CONFLICTO_TELEFONO","CONFLICTO_USUARIO","BLOQUEADO","TEL_INVALIDO","SIN_USUARIO"];
