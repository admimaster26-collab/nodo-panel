function chatMessageRole(m){
  m=m||{};
  let meta=m.metadata||m.meta||{};
  if(typeof meta==="string"){try{meta=JSON.parse(meta);}catch(_e){meta={};}}
  const role=String(m.tipo_emisor||m.emisor_tipo||m.TIPO_EMISOR||m.origen||"").toUpperCase();
  const name=String(m.operador||m.emisor||m.EMISOR||"").toUpperCase().trim();
  // El rol usuario tiene prioridad: su nombre o su texto nunca habilita tarjetas de operador.
  if(/^(USUARIO|USER|CLIENTE|JUGADOR)$/.test(role))return "user";
  if(m.auto===true||meta?.auto===true||/BOT|AUTO/.test(role))return "bot";
  if(/SISTEMA|SYSTEM/.test(role))return "system";
  if(/^(NODO|BOT|AUTOMATICO|AUTOMÁTICO)(?:\b|_)/.test(name))return "bot";
  if(/OPER|ADMIN|PANEL/.test(role)||/^(OPERADOR|ADMIN|PANEL)$/.test(name))return "operator";
  return "user";
}
