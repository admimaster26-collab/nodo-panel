  if(!resumen.ok){box.innerHTML='<div role="status" style="text-align:center;color:#fca5a5;font-size:12px;padding:12px">No pudimos actualizar el historial. Volvé a intentarlo.</div>';return;}
  const rows=resumen.rows;
  if(!rows.length){ box.innerHTML='<div style="text-align:center;color:#8b95a5;font-size:12px;padding:12px">Sin operaciones en los últimos 7 días.</div>'; return; }
  const filas=rows.map(function(r){
    const esRetiro=String(r.tipo||"").toUpperCase()==="RETIRO";
    const est=String(r.estado||"").toUpperCase();
    const rech=["RECHAZADA","ERROR","ERROR_OPERATIVO"].includes(est);
    // A qué billetera transfirió y con qué titular. Estaba en la base desde siempre y el
    // historial no lo mostraba: sin eso, cinco cargas de $5.000 son cinco filas idénticas.
    const bil=String(r.billetera||"").trim(), tit=String(r.titular||"").trim();
    // Una carga hecha en el mostrador no la pidió la persona por acá: si aparece sin aclarar
    // nada, parece una solicitud suya que no recuerda haber mandado.
    const enMostrador = String(r.origen||"").toUpperCase()==="MOSTRADOR";
    const detalle = (bil||tit)
      ? '<div style="width:100%;font-size:11px;color:#8b95a5;margin-top:2px;line-height:1.5">'
        + (enMostrador ? (esRetiro?"Te lo pagamos en el mostrador":"Te la cargamos nosotros") : "")
        + (enMostrador && bil ? "<br>" : "")
        + (bil ? (enMostrador ? "Billetera: " : (esRetiro?"A tu cuenta: ":"Transferiste a: "))+"<b style=\"color:#c9d3e0\">"+esc(bil)+"</b>" : "")
        + (bil&&tit ? "<br>" : "")
        + (tit ? "Titular: "+esc(tit) : "")
        + '</div>'
      : "";
    return '<div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:6px;background:#12141b;border:1px solid #23262f;border-radius:12px;padding:10px 12px;margin-top:8px">'
