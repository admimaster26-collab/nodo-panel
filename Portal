    if(who!=='user')text=text.replace(/⟦INGRESAR:([^⟧]*)⟧/g,function(_all,value){ing=String(value).split('|');return '';}).trim();
    const img=m.imagen_url||m.imagen||null;
    // Si este chat se cierra se sigue leyendo el hilo viejo, que no repite lo que ya vio por texto.
    state.shownTexts.add(who==='user'?(crudo?'u|'+crudo.substring(0,200):'uimg|'+String(img||'').substring(0,80)):crudo.substring(0,200));
    if(!text&&!img){if(ing)mostrarBotonIngresar(ing[0],ing[1]);continue;}
    const node=addMsg(escMsg(text),who,img,m);
    node._portalSignature=signature;
    node._portalCanonicalId=m.id==null?'':String(m.id);
    node._portalTs=Date.parse(m.created_at||m.fecha||'')||0;
    portalChatGlobos.set(key,node);
    if(old){host.insertBefore(node,old);old.remove();}
    else if(node._portalTs){
      // Cada globo va por la hora del servidor, venga de la tabla o del hilo. Pegar lo del hilo al
      // final desordenaba la charla cada vez que se volvía a abrir.
      const after=Array.from(host.children).find(n=>n!==node&&n._portalTs>node._portalTs);
      if(after)host.insertBefore(node,after);
    }else if(node._portalCanonicalId){
      const id=node._portalCanonicalId;
      const after=Array.from(host.children).find(n=>n!==node&&n._portalCanonicalId
        &&(n._portalCanonicalId.length>id.length||(n._portalCanonicalId.length===id.length&&n._portalCanonicalId>id)));
      if(after)host.insertBefore(node,after);
    }else if(prepend)host.insertBefore(node,first);
    if(ing)mostrarBotonIngresar(ing[0],ing[1]);
    if(!old&&notificar&&who!=='user'&&state.screen!=='chat'){
      bumpUnread();showOperatorBubble(text,img);
      if(text)notificarLocal('BET300 · '+(who==='operator'?'Operador':who==='bot'?'Asistente':'Sistema'),chatHelpMessage(text,who).text.substring(0,100),'/','bet300-op');
    }
  }
  marcarVistos(rows);
  if(prepend)host.scrollTop=previousTop+(host.scrollHeight-previousHeight);
}
function portalChatMostrarAnterior(data,append){
  if(!append&&portalChatInicializado)return;
  portalChatCursor=data.has_more?data.next_before_id:null;
  let button=$('chatEarlier');
  if(!portalChatCursor){if(button)button.remove();return;}
  if(!button){
    button=document.createElement('button');button.id='chatEarlier';button.type='button';
    button.className='ghost-btn';button.onclick=portalCargarMensajesAnteriores;
    $('messages').insertBefore(button,$('messages').firstChild);
  }
  button.disabled=false;button.textContent='Ver mensajes anteriores';
}
async function portalCargarMensajesAnteriores(){
  if(portalChatRuta!=='beta'||!portalChatCursor||portalChatHistorialVuelo)return;
  const key=portalChatClave(),cursor=portalChatCursor,button=$('chatEarlier');
  const flight={key};portalChatHistorialVuelo=flight;if(button)button.disabled=true;
  try{
    const res=await rpc(PORTAL_CHAT_BETA_RPC,{p_chat_id:state.chatId,p_chat_token:state.chatToken,p_limit:50,p_before_id:cursor});
    if(key!==portalChatClave())return;
    const data=portalChatBetaRespuesta(res);
    if(!data||!data.available)throw {code:'CAPACIDAD_CAMBIO'};
    portalChatRenderRows(data.rows,false,true);portalChatMostrarAnterior(data,true);
  }catch(error){
    if(key===portalChatClave()){
      portalChatSalud={...portalChatSalud,estado:'error',ultimoError:String(error&&error.code||'SIN_CONEXION')};
      if(button){button.disabled=false;button.textContent='Reintentar mensajes anteriores';}
    }
  }finally{if(portalChatHistorialVuelo===flight)portalChatHistorialVuelo=null;}
}
function portalChatBetaRespuesta(res){
  if(res&&res.error)throw res.error;
  let data=res&&res.data;if(typeof data==='string')data=JSON.parse(data);
  if(data&&data.ok===true&&data.available===false&&data.contract==='legacy')return data;
  if(!data||data.ok!==true||data.available!==true||data.contract!=='nodo.beta.v1'
    ||String(data.chat_id)!==String(state.chatId)
    ||!Array.isArray(data.rows)||!Array.isArray(data.legacy_thread)
    ||!Array.isArray(data.capabilities)||!data.capabilities.includes('portal.thread.v1')
    ||!data.capabilities.includes('portal.seen.v1')
    ||typeof data.has_more!=='boolean'||(data.has_more&&!data.next_before_id))throw {code:'CONTRATO_INVALIDO'};
  return data;
}
async function pollPortalConversation(){
  if(!state.usuario||!$('widget')?.classList.contains('open'))return;
  const key=portalChatPreparar();
  // Una lectura colgada no frena las siguientes para siempre: a los 20 s se pide de nuevo.
  if(portalChatVuelo&&portalChatVuelo.key===key&&Date.now()-portalChatVuelo.t<20000)return portalChatVuelo.promise;
  const flight={key,promise:null,t:Date.now()};portalChatVuelo=flight;
  const current=()=>key===portalChatClave();
  portalChatSalud={...portalChatSalud,estado:'consultando',ultimoError:null};
  flight.promise=(async()=>{
    try{
      let beta=null;
      const chatLegible=()=>state.chatId&&state.chatToken&&Date.now()>=portalChatCerradoHasta;
      if(chatLegible()&&(portalChatRuta!=='legacy'||Date.now()>=portalChatRevisarEn)){
        const res=await rpc(PORTAL_CHAT_BETA_RPC,{p_chat_id:state.chatId,p_chat_token:state.chatToken,p_limit:50,p_before_id:null});
        if(!current())return;
        if(chatCerradoEnServidor(res&&res.error))portalChatSeCerro();
        else if(portalChatFuncionAusente(res&&res.error,PORTAL_CHAT_BETA_RPC)){
          portalChatUsarRuta('legacy');portalChatRevisarEn=Infinity;
        }else{
          beta=portalChatBetaRespuesta(res);
          if(beta.available){
            portalChatUsarRuta('beta');
            // Si una desconexión dejó más de una página nueva, ofrecer el tramo
            // intermedio antes de seguir hacia el historial viejo. No saltarlo.
            const recovery=portalChatInicializado&&beta.rows.length>0
              &&!beta.rows.some(m=>portalChatGlobos.has(portalMensajeClave(m)));
            portalChatRenderRows(beta.rows,portalChatInicializado,false);
            portalChatRenderLegacy(portalChatSinCopias(beta.legacy_thread,beta.rows),true);
            // Un jugador puede tener dos pantallas con dos chats. Lo que NODO escribe va al hilo de su
            // usuario, y ese hilo se lee siempre: si no, le llegaba a una pantalla y a la otra no.
            // Cada 15 segundos y no cada 5: con todos los jugadores, una lectura más en cada vuelta pesa.
            let hiloUsuario=null;
            if(Date.now()>=portalChatHiloEn){
              portalChatHiloEn=Date.now()+15000;
              const delUsuario=await rpc('landing_portal_chat_thread_get',{p_usuario:state.usuario,p_public_code:state.publicCode,p_telefono:state.telefono||''});
              if(!current())return;
              hiloUsuario=delUsuario&&!delUsuario.error?(normalize(delUsuario.data)||delUsuario.data):null;
            }
            if(Array.isArray(hiloUsuario?.chat_thread)){
              const vistos=beta.rows.concat(beta.legacy_thread.map(m=>({...m,created_at:m.fecha})));
              portalChatRenderLegacy(portalChatSinCopias(hiloUsuario.chat_thread,vistos).map(m=>({...m,portal_key:'u:'+threadKey(m)})),true);
            }
            portalChatMostrarAnterior(beta,recovery);portalChatInicializado=true;
          }else{
            portalChatUsarRuta('legacy');portalChatRevisarEn=Date.now()+60000;
          }
        }
      }
      if(!beta||!beta.available){
        if(chatLegible()){
          const res=await rpc('landing_leer_chat_v2',{p_chat_id:state.chatId,p_chat_token:state.chatToken});
          if(!current())return;
          if(chatCerradoEnServidor(res.error))portalChatSeCerro();
          else if(res.error||!Array.isArray(res.data))throw res.error||{code:'CONTRATO_INVALIDO'};
          // Legacy no acredita visto, aunque devuelva leido:true por descarga.
          for(const m of (Array.isArray(res.data)?res.data:[])){
            const msgKey=String(m.id||m.created_at||JSON.stringify(m));
            if(state.seenMsgIds.has(msgKey))continue;state.seenMsgIds.add(msgKey);
            const who=chatMessageRole(m),text=m.mensaje||m.texto||'';
            if(who!=='user'&&(text||m.imagen_url)){
              const tk=(text||m.imagen_url||'').substring(0,200);
              if(!state.shownTexts.has(tk)){state.shownTexts.add(tk);incomingOperatorMsg(text,m.imagen_url||null,m);}
            }
          }
        }
        const res=await rpc('landing_portal_chat_thread_get',{p_usuario:state.usuario,p_public_code:state.publicCode,p_telefono:state.telefono||''});
        if(!current())return;
        if(res.error)throw res.error;
        const data=normalize(res.data)||res.data||{};
        if(!Array.isArray(data.chat_thread))throw {code:'CONTRATO_INVALIDO'};
        portalChatRenderLegacy(data.chat_thread);
      }
      if(!current())return;
      _onPollOk();
      portalChatSalud={estado:'respuesta_confirmada',contrato:portalChatRuta==='beta'?'nodo.beta.v1':'legacy',ultimoExito:new Date().toISOString(),ultimoError:null};
      if((state.nivelAcceso||'')!=='OK'&&state.telefono){
        state._revalTick=(state._revalTick||0)+1;
        if(state._revalTick===1||state._revalTick%3===0)autoChequeoValidacion();
      }
    }catch(error){
      if(current()){
        _onPollFail();portalChatSalud={...portalChatSalud,estado:'error',ultimoError:String(error&&error.code||'SIN_CONEXION')};
      }
    }finally{if(portalChatVuelo===flight)portalChatVuelo=null;}
  })();
  return flight.promise;
}

// Sólo receipt confirmado por el servidor para el ID exacto de esta conversación.
