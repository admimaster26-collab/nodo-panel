// ── Mensajería libre (chat) ────────────────────────────────────────────────
async function enviarMensajeSoporte(txt,imagenUrl=null,solicitudId=null){
  const mensaje=String(txt||"").trim();
  if(!mensaje&&!imagenUrl)return {ok:false,error:"El mensaje está vacío."};
  if(state._sendingSupport)return {ok:false,error:"Esperá a que termine el envío anterior."};
  state._sendingSupport=true;
  const context=[state.publicCode,state.pcCodigo,state.usuario].join("|");
  let legacySupport=false;
  const faltaFuncion=(error,name)=>!!error&&['PGRST202','42883'].includes(String(error.code||''))&&String(error.message||'').includes(name);
  try{

  // 1) Si todavia no hay conversacion, se abre UNA. landing_chat_abrir_v3 no reutiliza la del
  //    jugador: abre una limpia, sin el historial de meses que traia la anterior.
  const abrirConversacion=async(pedido)=>{
    try{
      const ch = await rpc("landing_chat_abrir_v3", {
        p_usuario: state.usuario, p_telefono: state.telefono || "",
        p_public_code: state.publicCode, p_solicitud_id: pedido?Number(pedido):null
      });
      const c = (ch && !ch.error) ? (normalize(ch.data) || ch.data || {}) : {};
      if(context!==[state.publicCode,state.pcCodigo,state.usuario].join("|"))return {ok:false,error:"Cambiaste de cuenta. Volvé a abrir el chat de esa cuenta."};
      if(c && c.ok && c.chat_id){
        state.chatId=String(c.chat_id);
        state.chatToken=String(c.chat_token||"");
        try{
          localStorage.setItem("bet300_chat_id",state.chatId);
          localStorage.setItem("bet300_chat_token",state.chatToken);
        }catch(_e){}
        return null;
      }
      if(faltaFuncion(ch&&ch.error,'landing_chat_abrir_v3')){legacySupport=true;return null;}
      return {ok:false,error:"No pudimos confirmar la conversación. Conservamos el mensaje para que puedas reintentar."};
    }catch(_e){return {ok:false,error:"No pudimos confirmar la conversación. Conservamos el mensaje para que puedas reintentar."};}
  };
  const enviarAlChat=()=>rpc("landing_enviar_mensaje_v2",{
    p_chat_id:state.chatId,p_chat_token:state.chatToken,
    p_emisor:state.usuario,p_mensaje:mensaje,p_imagen_url:imagenUrl||""
  });
  // Con un pedido (el comprobante de una carga) el chat queda atado a esa solicitud: así el operador
  // lo ve ahí, y no como una consulta suelta de más.
  const chatPrevio=!!(state.chatId && state.chatToken);
  if(!chatPrevio){
    const fallo=await abrirConversacion(solicitudId);
    if(fallo)return fallo;
  }

  // 2) El mensaje va al canal de chat.
  let res=null;
  if(state.chatId && state.chatToken)res=await enviarAlChat();

  // Ese chat lo cerró un operador: se abre uno nuevo y se manda ahí, una sola vez. Uno recién abierto
  // no se reintenta: si también lo rechaza, abrir otro sólo dejaría chats vacíos.
  if(chatPrevio&&chatCerradoEnServidor(res&&res.error)){
    olvidarChatCerrado();
    const fallo=await abrirConversacion(null);
    if(fallo)return fallo;
    res=(state.chatId && state.chatToken)?await enviarAlChat():null;
  }

  // 3) Sólo una función explícitamente ausente habilita la ruta anterior. Un timeout
  // pudo ocurrir DESPUÉS de guardar: no enviar otro POST que duplique la consulta.
  if(res?.error&&/NO_AUTORIZADO|NO_REGISTRADO|BLOQUEADO|CONFLICTO|no autorizado/i.test(res.error.message||""))return {ok:false,error:"No pudimos validar la conversación. Revisá tus datos de acceso."};
  if(faltaFuncion(res&&res.error,'landing_enviar_mensaje_v2'))legacySupport=true;
  if(legacySupport){
    const bp=billeteraPayloadPlano();
    const payload={usuario:state.usuario,telefono:state.telefono||"",pc_codigo:state.pcCodigo,public_code:state.publicCode,host:location.host,tipo:"SOPORTE",...bp,...(imagenUrl?{imagen_url:imagenUrl}:{}),..._marcaDeTiempo()};
    res=await rpc("landing_portal_v16_crear_solicitud",{
      p_public_code:state.publicCode,p_usuario:state.usuario,
      p_tipo:"SOPORTE",p_monto:0,p_titular:"",p_destino:null,
      p_mensaje:mensaje||(imagenUrl?"📎 Imagen adjunta":""),p_metadata:payload
    });
  }

  const confirmado=res&&!res.error&&(normalize(res.data)||res.data||{});
  if(context!==[state.publicCode,state.pcCodigo,state.usuario].join("|"))return {ok:false,error:"Cambiaste de cuenta. Revisá el chat de la cuenta desde la que enviaste."};
  if(!confirmado||confirmado.ok!==true)return {ok:false,error:"No pudimos confirmar el envío. Conservamos el mensaje para que puedas reintentar."};
  startChatPoll();
  startPortalThreadPoll();
  return {ok:true,message_id:!legacySupport&&(confirmado.mensaje_id||confirmado.message_id)||null,chat_id:state.chatId};
  }catch(_e){return {ok:false,error:"No pudimos conectar. Conservamos el mensaje para que puedas reintentar."};}
  finally{state._sendingSupport=false;}
}

