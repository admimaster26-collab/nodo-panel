async function initRoute(){
  if(MODO_PRUEBA){
    state.publicCode = MODO_PRUEBA.ruta;
    const rp = await rpc("landing_resolver_ruta_publica",{p_public_code:state.publicCode});
    const filaP = rp.error ? null : normalize(rp.data);
    if(filaP){ state.pcCodigo = filaP.pc_codigo||filaP.pc||filaP.codigo_pc||null; }
    console.log("[BET300 PRUEBAS]", MODO_PRUEBA.oficina, state.publicCode, "->", state.pcCodigo);
    return;                       // sin mudanza de dominio: te quedás donde estás
  }
  const qp=(new URLSearchParams(location.search).get("r")||"").trim();
  if(qp){ _fijarOficina(qp); }
  if(!qp){
    try{
      const rh=await rpc("landing_resolver_ruta_por_host",{p_host:location.host});
      const dh=normalize(rh.data)||rh.data||{};
      if(dh && dh.ok && (dh.pc_codigo||dh.public_code)){
        state.pcCodigo=dh.pc_codigo||null;
        if(dh.public_code){ _fijarOficina(dh.public_code); }
        console.log("[BET300] agente por host",location.host,"->",state.pcCodigo,state.publicCode);
        if(state.pcCodigo) return;
      }
    }catch(_e){}
  }
  if(!state.publicCode){ state.publicCode = localStorage.getItem("bet300_public_code") || ""; }
