async function pollOperatorMessages(){
  if(!state.chatId||!$("widget")?.classList.contains("open"))return;
  const res=await rpc("landing_leer_chat_v2",{p_chat_id:Number(state.chatId),p_chat_token:state.chatToken});
  if(res.error||!Array.isArray(res.data)){_onPollFail();return;}
  _onPollOk();
  // El servidor ya manda `leido` por mensaje en esta misma respuesta: no hace falta pedir nada
  // más. Hoy se pone en true cuando NODO descarga la conversación; cuando el panel mande el
  // acuse explícito va a significar "el operador lo vio en pantalla". El Portal no cambia: lee
  // el mismo campo y el tilde se vuelve más honesto solo.
  try{ marcarVistos(res.data); }catch(_e){}
  res.data.forEach(m=>{
    const msgKey=String(m.id||m.created_at||JSON.stringify(m));
    if(state.seenMsgIds.has(msgKey))return;
    state.seenMsgIds.add(msgKey);
    const who=chatMessageRole(m);
    const isOp=who!=="user";
    const texto=m.mensaje||m.texto||"";
    if(isOp&&(texto||m.imagen_url)){const tk=(texto||m.imagen_url||"").substring(0,200);if(state.shownTexts.has(tk))return;state.shownTexts.add(tk);incomingOperatorMsg(texto,m.imagen_url||null,m);if(texto)notificarLocal("BET300 · "+(who==="operator"?"Operador":who==="bot"?"Bot automático":"Sistema"),chatHelpMessage(texto,who).text.substring(0,100),"/","bet300-op");}
  });
}

// Pinta el tilde de visto en los mensajes del jugador. Dos estados, nada más:
//   ✓  gris    → se envió
//   ✓✓ celeste → del otro lado ya lo leyeron
// No inventa: si el servidor no dice nada, queda en gris.
function marcarVistos(filas){
  if(!Array.isArray(filas)||!state.misGlobos||!state.misGlobos.size)return;
  for(const m of filas){
    if(chatMessageRole(m)!=="user")continue;
    if(!(m&&m.leido===true))continue;
    const _t=m.mensaje||"";
    const _k=_t?("u|"+String(_t).substring(0,200)):("uimg|"+String(m.imagen_url||"").substring(0,80));
    const _g=state.misGlobos.get(_k);
    if(!_g)continue;
    const _v=_g.querySelector(".visto");
    if(_v&&!_v.classList.contains("si")){ _v.textContent="✓✓"; _v.classList.add("si"); _v.setAttribute("aria-label","visto"); }
  }
}

