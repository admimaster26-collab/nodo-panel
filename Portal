/* Tilde de visto: gris = enviado, celeste = del otro lado ya lo vieron. */
.msg.user .meta .visto{margin-left:5px;font-weight:800;letter-spacing:-2px;color:var(--muted-2)}
.msg.user .meta .visto.si{color:#4aa8ff}
