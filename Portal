      p_mensaje:msg,p_tipo:"RETIRO",p_extra:payload
    });
  }
  if(res.error){_restaurarBoton("btnEnviarRetiro","Enviar retiro a revisión");toast("No pudimos enviar el retiro. Probá por el chat.");goChat();return;}
  const dataR=normalize(res.data)||res.data||{};
