#imgPreviewBar img{width:36px;height:36px;object-fit:cover;border-radius:8px;flex-shrink:0}
#imgPreviewBar span{font-size:11.5px;color:var(--muted);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#imgPreviewBar button{border:none;background:none;color:var(--muted);cursor:pointer;font-size:21px;line-height:1;padding:0 2px;flex-shrink:0}

/* Toast */
.toast{position:fixed;left:50%;bottom:calc(86px + var(--safe-b));transform:translateX(-50%) translateY(10px);z-index:60;background:#16161c;color:#fff;border:1px solid var(--line-2);box-shadow:0 16px 40px rgba(0,0,0,.6);padding:14px 18px;border-radius:12px;font-weight:800;font-size:13px;opacity:0;pointer-events:none;transition:opacity .2s,transform .2s;max-width:320px;text-align:center}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* ── Desktop: panel acotado a la derecha ────────────────────────────────── */
@media(min-width:760px){
  .panel{left:auto;right:24px;top:auto;bottom:24px;width:420px;height:min(720px,calc(100vh - 48px));
    border:1px solid var(--line-2);border-radius:20px;overflow:hidden;
    transform:translateY(calc(100% + 24px))}
  .panel.open{transform:none}
  .panel-head{padding-top:15px}
}

/* Quién habla: se distingue de un vistazo, también en pantallas chicas. */
.msg.operator{align-items:flex-start;margin-right:auto}
.msg.operator .bubble{background:#16283b;border:1px solid #3b6b8d;border-bottom-left-radius:5px}
