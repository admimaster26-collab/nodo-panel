  // Comparación floja: alcanza con que el nombre esté adentro, porque una guarda el alias y la
  // otra puede no traerlo.
  const norm = (v)=>String(v||"").toLowerCase().replace(/[^a-z0-9]/g,"");
  const nd = norm(dela), na = norm(activaTxt);
  const cambio = !!(nd && na && nd.indexOf(na)===-1 && na.indexOf(nd)===-1);
