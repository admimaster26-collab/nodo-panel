  }
  const ok=["OK","APROBADA","ACREDITADA","PAGADA","COMPLETADA"].includes(u);
  const rech=["RECHAZADA","ERROR","ERROR_OPERATIVO"].includes(u);
  const col=ok?"#22c55e":rech?"#ef4444":"#f5c518", txt=ok?"Confirmada":rech?"Rechazada":"En revisión";
