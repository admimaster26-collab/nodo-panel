// Traer el CBU y el titular del último retiro y dejarlos puestos. Antes había que tipear los
// dos de memoria cada vez, o irlos a buscar a otra app con el portal abierto. Los campos
// quedan EDITABLES y se avisa de dónde salieron: si cobra en otra cuenta, los cambia y listo.
function _retiroRpcInexistente(error){
  const code=String(error&&error.code||"").toUpperCase(),msg=String(error&&error.message||"");
  return code==="PGRST202"||code==="42883"||(/landing_portal_retiro_contexto_v1/i.test(msg)&&/does not exist|not found|could not find/i.test(msg));
}
async function _consultarRetiroProtocolo(forzar){
  const key=[state.publicCode||"",state.usuario||"",state.telefono||"",location.host||""].join("|");
  const cache=state._retiroProtocoloCache;
  if(!forzar&&cache&&cache.key===key&&Date.now()-cache.at<30000)return cache.value;
  let result;
  try{
    const r=await rpc("landing_portal_retiro_contexto_v1",{
      p_public_code:state.publicCode||"",p_usuario:state.usuario||"",
      p_telefono:state.telefono||"",p_host:location.host||""
    });
    if(r.error){
      result=_retiroRpcInexistente(r.error)?{mode:"legacy"}:{mode:"error",code:"RETIRO_CONTEXTO_NO_DISPONIBLE"};
    }else{
      const d=normalize(r.data)||r.data||{};
      if(d.ok!==true||d.contract!=="retiro.instrumentos.v1"||typeof d.enabled!=="boolean")
        result={mode:"error",code:"RETIRO_CONTEXTO_RESPUESTA_INVALIDA"};
      else result=Object.assign({},d,{mode:d.enabled?"beta":"legacy"});
    }
  }catch(_e){result={mode:"error",code:"RETIRO_CONTEXTO_NO_DISPONIBLE"};}
  state._retiroProtocolo=result;
  state._retiroProtocoloCache={key:key,at:Date.now(),value:result};
  return result;
}
async function _leerDatosRetiroAnterior(){
  try{
    const r=await rpc("landing_datos_retiro",{
      p_usuario:state.usuario||"",p_telefono:state.telefono||"",p_public_code:state.publicCode||""
    });
    const d=r.error?null:(normalize(r.data)||(Array.isArray(r.data)?r.data[0]:r.data)||null);
    if(!d||!String(d.destino||"").trim())return null;
    return {destino:String(d.destino||"").trim(),titular:String(d.titular||"").trim()};
  }catch(_e){return null;}
}
async function leerDatosRetiro(){
  const protocolo=await _consultarRetiroProtocolo(false);
  if(protocolo.mode==="error")return {error:true,protocolo:protocolo};
  if(protocolo.mode==="beta"&&protocolo.instrumento){
    const i=protocolo.instrumento;
    return {destino:String(i.destino||"").trim(),titular:String(i.titular||"").trim(),beta:true,validado:true,protocolo:protocolo};
  }
  const anterior=await _leerDatosRetiroAnterior();
  if(protocolo.mode==="beta")return Object.assign({beta:true,validado:false,protocolo:protocolo},anterior||{});
  return anterior;
}
