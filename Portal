function marcarVistos(filas){
  if(!Array.isArray(filas)||!state.misGlobos)return;
  for(const m of filas){
    if(chatMessageRole(m)!=='user'||m.id==null||m.visto_confirmado!==true)continue;
    const node=state.misGlobos.get(portalMensajeClave(m));if(!node)continue;
    const tick=node.querySelector('.visto');
    if(tick&&!tick.classList.contains('si')){tick.textContent='✓✓';tick.classList.add('si');tick.setAttribute('aria-label','visto');}
  }
}

