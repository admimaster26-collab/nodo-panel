// Traer el CBU y el titular del último retiro y dejarlos puestos. Antes había que tipear los
// dos de memoria cada vez, o irlos a buscar a otra app con el portal abierto. Los campos
// quedan EDITABLES y se avisa de dónde salieron: si cobra en otra cuenta, los cambia y listo.
async function _rellenarDatosRetiro(){
  const cajaAviso = $("retiroDatosPrevios");
  const elD = $("retiroDestino"), elT = $("retiroTitular");
  if(!elD || !elT) return;
  // Si la persona ya empezó a escribir, no se le pisa nada.
  if(String(elD.value||"").trim() || String(elT.value||"").trim()) return;
  let d = null;
  try{
    const r = await rpc("landing_datos_retiro", {
      p_usuario: state.usuario||"", p_telefono: state.telefono||"",
      p_public_code: state.publicCode||""
    });
    if(!r.error) d = normalize(r.data) || (Array.isArray(r.data)?r.data[0]:r.data) || null;
  }catch(_e){}
  if(!d || !String(d.destino||"").trim()) return;

  elD.value = String(d.destino||"").trim();
  elT.value = String(d.titular||"").trim();
  try{ onTitularInput(elT); }catch(_e){}
  if(cajaAviso){
    cajaAviso.innerHTML = '<div class="retiro-previos">'
      + 'Pusimos los datos de tu último retiro. <b>Si cobrás en otra cuenta, cambialos.</b>'
      + '</div>';
  }
}

