.bil-sol.cambio{background:rgba(245,158,11,.10);border-color:rgba(245,158,11,.45)}
.bil-sol-k{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:2px}
.bil-sol-v{font-size:14.5px;font-weight:800;word-break:break-word}
.bil-sol-aviso{margin-top:8px;font-size:12px;line-height:1.5;color:var(--gold-2)}
.estado-tx{font-size:13.5px;color:#c9c9d2;line-height:1.55;margin-bottom:16px}
