    if(_jsonDe(registro.cierre))return '<span style="font-size:11px;color:#8b95a5">Cerrado</span>';
    if(u==='EN_PROCESO' && Number(registro.pagado)>0)return '<span style="font-size:11px;color:#f5c518">Te lo estamos pagando</span>';
  }
