// ── Estado (pantalla) ──────────────────────────────────────────────────────
// ── Historial del usuario (últimos 7 días) ───────────────────────────────────
// Un lector por identidad para historial y rechazo previo. La ruta se elige una vez:
// beta si existe; legacy sólo si PostgREST confirma que falta esa función concreta.
// Sin timer nuevo ni segundo intento por un timeout. Cache breve en memoria, sin PII en salud.
const HISTORIAL_BETA_RPC='landing_historial_usuario_beta_v1';
let historialRuta='beta', historialVuelo=null, historialCache=null;
let historialSalud={estado:'sin_consultar',contrato:null,ultimoExito:null,ultimoError:null};
function portalHistorialEstado(){return {...historialSalud,ruta:historialRuta,enCurso:!!historialVuelo};}
function _historialZona(){
  try{return Intl.DateTimeFormat().resolvedOptions().timeZone||'America/Argentina/Buenos_Aires';}
  catch(_e){return 'America/Argentina/Buenos_Aires';}
}
function _historialClave(){return JSON.stringify([state.usuario||'',state.telefono||'',state.publicCode||'',_historialZona()]);}
function _historialFuncionAusente(error){
  return !!error && ['PGRST202','42883'].includes(String(error.code||''))
    && String(error.message||'').includes(HISTORIAL_BETA_RPC);
}
function _historialLegacy(rows){
  const rechazos={CARGA:null,RETIRO:null};
  for(const r of rows){
    const tipo=String(r.tipo||'').toUpperCase();
    if((tipo==='CARGA'||tipo==='RETIRO') && !rechazos[tipo]
      && ['RECHAZADA','CANCELADA','ERROR','ERROR_OPERATIVO'].includes(String(r.estado||'').toUpperCase())
      && String(r.motivo||'').trim() && _mismoTurno(r.fecha))rechazos[tipo]=r;
  }
  return {ok:true,contract:'portal.historial.legacy',rows,rechazos_turno:rechazos};
}
async function cargarResumenHistorial(){
  if(!state.usuario||!state.telefono)return {ok:true,rows:[],rechazos_turno:{}};
  const clave=_historialClave(), ahora=Date.now();
  if(historialVuelo && historialVuelo.clave===clave)return historialVuelo.promise;
  // Nunca reutilizar el aviso cuando cambió el turno. El servidor entrega su límite.
  if(historialCache && historialCache.clave===clave && ahora-historialCache.ts<1500
    && (!historialCache.data.turno_hasta || ahora<new Date(historialCache.data.turno_hasta).getTime()))return historialCache.data;
  const args={p_usuario:state.usuario,p_telefono:state.telefono,p_public_code:state.publicCode||''};
  const vuelo={clave,promise:null};
  historialVuelo=vuelo;
  historialSalud={...historialSalud,estado:'consultando',ultimoError:null};
  vuelo.promise=(async()=>{
    try{
      let res;
      if(historialRuta==='beta'){
        res=await rpc(HISTORIAL_BETA_RPC,{...args,p_zona_horaria:_historialZona()});
        if(_historialFuncionAusente(res&&res.error)){
          historialRuta='legacy';
          res=await rpc('landing_historial_usuario',args);
        }
      }else res=await rpc('landing_historial_usuario',args);
      if(res&&res.error)throw res.error;
      let data=res&&res.data;
      if(typeof data==='string')data=JSON.parse(data);
      if(historialRuta==='legacy'){
        if(!Array.isArray(data))throw {code:'CONTRATO_INVALIDO'};
        data=_historialLegacy(data);
      }else if(!data || data.ok!==true || data.contract!=='portal.historial.v1'
        || !Array.isArray(data.rows) || !data.rechazos_turno || !data.turno_hasta){
        throw {code:data&&data.code||'CONTRATO_INVALIDO'};
      }
      // Una respuesta tardía de otra identidad no debe volver a pintarse ni llenar el cache.
      if(_historialClave()!==clave)return {ok:false,code:'CONTEXTO_CAMBIO',rows:[],rechazos_turno:{}};
      historialCache={clave,ts:Date.now(),data};
      historialSalud={estado:'respuesta_confirmada',contrato:data.contract,ultimoExito:new Date().toISOString(),ultimoError:null};
      return data;
    }catch(error){
      const code=String(error&&error.code||'SIN_CONEXION');
      if(_historialClave()===clave)historialSalud={...historialSalud,estado:'error',ultimoError:code};
      return {ok:false,code,rows:[],rechazos_turno:{}};
    }finally{if(historialVuelo===vuelo)historialVuelo=null;}
  })();
  return vuelo.promise;
}
async function cargarHistorialUsuario(){
  const resumen=await cargarResumenHistorial();
  return resumen.rows;
}
function _fechaCorta(iso){
  // 24 h y con año corto: "06/08 09:01" — exacto y sin el "a. m." con espacios de es-AR.
  try{
    const d=new Date(iso); if(isNaN(d.getTime())) return "";
    const p=n=>String(n).padStart(2,"0");
    return p(d.getDate())+"/"+p(d.getMonth()+1)+" "+p(d.getHours())+":"+p(d.getMinutes());
  }catch(_e){ return ""; }
}
function _estadoBadge(e, canceladaPor){
  const u=String(e||"").toUpperCase();
  // Una que cancelaste vos NO es un rechazo nuestro. Iban las dos en rojo y como "Rechazada",
  // así que cancelar tu propia carga se leía como si te la hubiéramos rechazado.
  if(u==="CANCELADA"){
    const propia = String(canceladaPor||"").toUpperCase()==="JUGADOR";
    return '<span style="font-size:11px;font-weight:800;color:#8b95a5">'
      + (propia ? "Cancelada por vos" : "Cancelada") + '</span>';
  }
  const ok=["OK","APROBADA","ACREDITADA","PAGADA","COMPLETADA"].includes(u);
  const rech=["RECHAZADA","ERROR","ERROR_OPERATIVO"].includes(u);
  const col=ok?"#22c55e":rech?"#ef4444":"#f5c518", txt=ok?"Confirmada":rech?"Rechazada":"En revisión";
  return '<span style="font-size:11px;font-weight:800;color:'+col+'">'+txt+'</span>';
}
// ── Motivo del rechazo anterior, antes de volver a mandar ──────────────────
// Si la operación anterior se rechazó DENTRO DEL MISMO TURNO, se lo mostramos arriba del
// formulario. Sin esto la persona vuelve a mandar exactamente lo mismo y la vuelve a comer el
// mismo rechazo — y el operador la vuelve a rechazar. Pasado el turno no se muestra: ya es otra
// jornada, el motivo perdió contexto y sólo asusta.
// Los turnos son bloques de 8 h (00-08 / 08-16 / 16-24), que es como se etiquetan TM/TT/TN.
// Si en la operación se usan otros límites, se cambia SOLO esta constante.
const TURNO_HORAS=8;
function _turnoDe(d){ return Math.floor(d.getHours()/TURNO_HORAS); }
function _mismoTurno(iso){
  try{
    const d=new Date(iso); if(isNaN(d.getTime())) return false;
    const h=new Date();
    return d.toDateString()===h.toDateString() && _turnoDe(d)===_turnoDe(h);
  }catch(_e){ return false; }
}
