let guiaActual=null,guiaPintada=false,guiaOcupada=false,guiaPausaMs=220;
// A propósito a la manera vieja: la forma corta no existe en iPhone anteriores a iOS 15.4 ni en
// Chrome anteriores a 93, y ahí rompía el chat entero al recargar.
function guiaTiene(obj,clave){return Object.prototype.hasOwnProperty.call(obj,clave);}

function guiaIdentidadActual(){return {ruta:state.publicCode||"",usuario:String(state.usuario||"").toLowerCase()};}
function guiaGuardar(){
  const g=guiaActual;if(!g)return;
  g.usuario=guiaIdentidadActual().usuario;g.updatedAt=Date.now();
  try{sessionStorage.setItem(GUIA_CLAVE,JSON.stringify({version:GUIA_VERSION,ruta:g.ruta,usuario:g.usuario,nodo:g.nodo,tema:g.tema,burbujas:g.burbujas,personaAt:g.personaAt,pedido:g.pedido,humano:g.humano,fragmentos:g.fragmentos,updatedAt:g.updatedAt}));}catch(_e){}
}
function guiaGuardada(ruta,usuario){
  let s=null;
  try{s=JSON.parse(sessionStorage.getItem(GUIA_CLAVE)||"null");}catch(_e){}
  const vale=s&&s.version===GUIA_VERSION&&Number.isFinite(s.updatedAt)&&Date.now()-s.updatedAt<GUIA_VIGENCIA_MS
    &&s.ruta===ruta&&s.usuario===usuario&&guiaTiene(GUIA_RAMAS,s.nodo)&&Array.isArray(s.burbujas);
  if(!vale)return null;
  return {nodo:s.nodo,tema:String(s.tema||""),personaAt:Number(s.personaAt)||0,pedido:s.pedido&&typeof s.pedido==="object"?s.pedido:null,humano:!!s.humano,fragmentos:Number(s.fragmentos)||0,
    burbujas:s.burbujas.filter(b=>b&&["guide","user"].includes(b.q)&&typeof b.h==="string"&&b.h.length<=1200&&typeof b.at==="string").slice(-40)};
}
function guiaCargar(){
  const {ruta,usuario}=guiaIdentidadActual();
  if(guiaActual){
    // Se identificó recién, adentro del chat: es la misma charla. Otra cuenta u otra oficina, no.
    if(guiaActual.ruta===ruta&&(guiaActual.usuario===usuario||!guiaActual.usuario))return guiaActual;
    guiaOlvidar();
  }
  guiaActual={ruta,usuario,nodo:"inicio",tema:"",burbujas:[],personaAt:0,pedido:null,humano:false,fragmentos:0,lista:[],fallos:0,ingreso:null,esperaTexto:false,updatedAt:Date.now(),...(guiaGuardada(ruta,usuario)||{})};
  return guiaActual;
}
function guiaOlvidar(){
  try{sessionStorage.removeItem(GUIA_CLAVE);}catch(_e){}
  guiaActual=null;guiaPintada=false;guiaOcupada=false;
  guiaQuitarAccion();
  document.querySelectorAll(".guide-local").forEach(el=>el.remove());
}
function guiaFaltaIdentidad(){return !state.usuario||!state.telefono;}
// Una persona ya está al tanto: lo que se escriba a mano va directo, sin volver a confirmarlo.
function guiaPersonaAvisada(){return Date.now()-guiaCargar().personaAt<GUIA_PERSONA_AVISADA_MS;}
// Lo único que se frena es repetir EXACTAMENTE el mismo pedido enseguida, por el mismo chat y sin
// que nadie haya contestado. Otro tema, un chat cerrado o una respuesta del operador lo destraban:
// un pedido nuevo tiene que llegar siempre.
function guiaPedidoRepetido(texto){
  const p=guiaCargar().pedido;
  return !!p&&p.texto===texto&&p.chat===String(state.chatId||"")&&Date.now()-p.at<GUIA_REPETIR_PEDIDO_MS;
}

// ── Lo que se ve ─────────────────────────────────────────────────────────────
function guiaBurbuja(html,who,at){
  const host=$("messages"),accion=$("guiaAccion");
  const anterior=accion?accion.previousElementSibling:host?.lastElementChild;
  if(who==="guide"&&anterior?.classList?.contains("guide"))anterior.classList.add("guia-seguido");
  return addMsg(html,who,null,{local:true,fecha:at});
}
function guiaAnotar(html,who){
  const g=guiaCargar(),at=new Date().toISOString();
  g.burbujas.push({q:who,h:html,at});g.burbujas=g.burbujas.slice(-40);
  guiaGuardar();
  return guiaBurbuja(html,who,at);
}
function guiaDecir(html){return guiaAnotar(html,"guide");}
function guiaDijo(texto){return guiaAnotar(esc(texto),"user");}
// Lo que espera una respuesta del jugador (opciones o ficha) es UN solo elemento y va siempre
// último: lo que llegue mientras tanto se mete arriba suyo.
function guiaQuitarAccion(){$("guiaAccion")?.remove();}
function guiaPintarAccion(html,clase){
  guiaQuitarAccion();
  const box=document.createElement("div");
  box.id="guiaAccion";box.className="guia-accion guide-local"+(clase?" "+clase:"");
  box.innerHTML=html;
  $("messages").appendChild(box);
  scrollChat();
  return box;
}
function guiaBotones(lista,op={}){
  const g=guiaCargar(),todas=lista.slice();
  if(!op.sinPersona)todas.push({t:"👤 Hablar con una persona",hace:"persona",sinEco:true,clase:"humano"});
  if(!op.sinVolver)todas.push({t:"‹ Otra consulta",eco:"Otra consulta",va:"inicio",clase:"volver"});
  g.lista=todas;
  if(!todas.length)return "";
  // Una opción con href sale de la página (WhatsApp): es un <a> de verdad y no un window.open después
  // de la pausa, que el iPhone y los bloqueadores frenan porque ya no viene del toque.
  return '<div class="guia-opciones" role="group" aria-label="Opciones">'
    +todas.map((o,i)=>o.href
      ?'<a'+(o.clase?' class="'+o.clase+'"':'')+' href="'+esc(o.href)+'" target="_blank" rel="noopener">'+esc(o.t)+'</a>'
      :'<button type="button"'+(o.clase?' class="'+o.clase+'"':'')+' onclick="guiaTocar('+i+')">'+esc(o.t)+'</button>').join("")+'</div>';
}
function guiaOfrecer(lista,op){guiaPintarAccion(guiaBotones(lista,op));}
function guiaFicha(html,lista=[],op={}){
  const box=guiaPintarAccion(html+guiaBotones(lista,op),"con-ficha");
  try{box.scrollIntoView({block:"start",behavior:"smooth"});}catch(_e){}
  return box;
}
function guiaFallo(texto,reintento,op={}){
  const lista=reintento?[{t:"Probar de nuevo",hace:reintento,sinEco:true}]:[];
  guiaPintarAccion('<div class="guia-error" role="alert">'+esc(texto)+'</div>'+guiaBotones(lista,op));
}
function guiaErrorFicha(texto,campo){
  const e=$("guiaError");if(e)e.textContent=texto;
  if(campo){try{$(campo)?.focus();}catch(_e){}}
  haptic(18);
}
async function guiaCorrer(paso){
  guiaOcupada=true;
  guiaPintarAccion('<div class="guia-puntos" role="status" aria-label="Escribiendo"><i></i><i></i><i></i></div>',"guia-espera");
  try{
    if(guiaPausaMs)await new Promise(r=>setTimeout(r,guiaPausaMs));
    await paso();
  }catch(e){
    console.warn("[asistente]",e);
    guiaFallo("Algo falló de mi lado. Probá de nuevo o pedí una persona.");
  }finally{
    guiaOcupada=false;
    if($("guiaAccion")?.classList.contains("guia-espera"))guiaOfrecer([]);
  }
}
function guiaTocar(i){
  const g=guiaCargar(),o=g.lista[i];
  // Con una ficha enviándose no se puede salir: se perdería el ticket o el aviso de que falló.
  if(!o||guiaOcupada||_enviando)return;
  haptic(6);
  // El teclado del iPhone sólo se abre adentro del toque, no después de la pausa.
  if(o.hace==="otraCosa"){try{$("freeInput")?.focus();}catch(_e){}}
  if(o.tema)g.tema=GUIA_TEMAS[o.tema];
  if(!o.sinEco)guiaDijo(o.eco||o.t);
  return guiaCorrer(async()=>{
    if(guiaChequeo)await guiaChequeo;
    if(guiaSinValidar()&&(o.va?o.va!=="inicio":!GUIA_SIN_VALIDAR_HACE.includes(o.hace)))return guiaIr("inicio");
    return o.va?guiaIr(o.va):GUIA_HACE[o.hace](o);
  });
}
function guiaIr(id){
  if(guiaSinValidar())id="inicio";
  const g=guiaCargar(),rama=GUIA_RAMAS[id];
  if(rama.identidad&&guiaFaltaIdentidad())return guiaPedirIdentidad(()=>guiaIr(id));
  g.nodo=id;g.tema=rama.tema?GUIA_TEMAS[rama.tema]:"";g.ingreso=null;g.esperaTexto=false;
  guiaDecir(typeof rama.dice==="function"?rama.dice():rama.dice);
  guiaOfrecer(rama.opciones(),{sinVolver:id==="inicio",sinPersona:id==="inicio"&&guiaEsperandoValidacion()});
}
function guiaReponerMenu(){
  const g=guiaCargar();
  if(guiaEsperandoValidacion())return guiaOfrecer([],{sinPersona:true,sinVolver:true});
  if(g.humano)return guiaOfrecer([{t:"Ver opciones",va:"inicio"}],{sinPersona:true,sinVolver:true});
  const nodo=guiaSinValidar()?"inicio":g.nodo;
  guiaOfrecer(GUIA_RAMAS[nodo].opciones(),{sinVolver:nodo==="inicio"});
}
function guiaMostrar(){
  const g=guiaCargar();
  if(guiaPintada)return;
  guiaPintada=true;
  guiaChequearCuenta();
  if(!g.burbujas.length){
    // Ya viene hablando con una persona: el saludo y el menú no van encima de esa charla.
    if(g.humano)return guiaReponerMenu();
    guiaDecir(GUIA_SALUDO);guiaIr("inicio");return;
  }
  g.burbujas.forEach(b=>guiaBurbuja(b.h,b.q,b.at));
  guiaReponerMenu();
}
// Al abrir el chat se le pregunta al servidor si la cuenta está validada, ANTES de que pueda elegir
// algo: el menú arranca con lo que dice el teléfono y, si el servidor dice otra cosa, se rearma.
// Un toque que llega antes de la respuesta la espera (guiaTocar).
let guiaChequeo=null;
function guiaChequearCuenta(){
  if(guiaFaltaIdentidad())return null;
  const antes=guiaSinValidar();
  guiaChequeo=Promise.resolve().then(()=>vinculoPuedeOperar()).catch(()=>{}).then(()=>{
    guiaChequeo=null;
    if(guiaSinValidar()===antes||guiaOcupada||$("guiaAccion")?.classList.contains("con-ficha"))return;
    const g=guiaCargar();
    if(g.humano)return guiaReponerMenu();
    guiaIr("inicio");
  });
  return guiaChequeo;
}
// Validar desde el menú corto. Validado, sigue con lo que había venido a hacer, si había algo.
function guiaValidarCuenta(){
  guiaCargar().ingreso={modo:"validar",siguiente:()=>{
    const que=despuesPendiente();
    if(que){despuesDeValidar("");return GUIA_DESPUES[que]();}
    return guiaIr("inicio");
  }};
  guiaFichaIngreso();
}
// Nunca por encima de una persona: si contesta un operador, el menú se repliega a un solo botón.
// Sólo si contesta AHORA: un mensaje viejo del historial no le saca el menú al que vuelve.
function guiaCederAPersona(cuando){
  if(cuando&&Date.now()-new Date(cuando).getTime()>GUIA_PERSONA_AVISADA_MS)return;
  const g=guiaCargar();
  g.pedido=null;
  if(g.humano)return guiaGuardar();
  g.humano=true;guiaGuardar();
  const accion=$("guiaAccion");
  if(accion&&!guiaOcupada&&!accion.classList.contains("con-ficha"))guiaReponerMenu();
}
// Cerraron el chat: lo pedido antes ya no frena un pedido igual.
function guiaChatCerrado(){
  if(!guiaActual||!guiaActual.pedido)return;
  guiaActual.pedido=null;guiaGuardar();
}
// Tarjetas que manda el operador con las macros del panel (⟦AYUDA:…⟧).
function guiaAbrirTarjeta(action){
  if(guiaOcupada||!["inicio","revisar_envio"].includes(action))return;
  goChat();
  if(action==="inicio"){guiaDijo("Ver las opciones");return guiaCorrer(()=>guiaIr("inicio"));}
  guiaCargar().tema=GUIA_TEMAS.noAparece;
  guiaDijo("Revisar una transferencia");
  return guiaCorrer(guiaNoAparecio);
}

// ── Lo que escribe a mano ────────────────────────────────────────────────────
// «?», «hola», «3000»: es el 19 % de los chats y nadie puede contestarlos. No se adivina: se vuelve
// a ofrecer el menú. Una sola vez, para que nadie se sienta atrapado.
function guiaEsFragmento(txt){
  const t=String(txt||"").trim();
  return t.length<=20&&t.split(/\s+/).filter(Boolean).length<=2;
}
function guiaFrenarFragmento(txt){
  const g=guiaCargar();
  // Sólo al arrancar: con una conversación abierta, lo corto puede ser la respuesta a un operador
  // («5000», «dale», «Juan Perez») y tiene que llegar.
  if(state.chatId||g.humano||g.esperaTexto||g.fragmentos>=1||guiaPersonaAvisada()||!guiaEsFragmento(txt))return false;
  if($("guiaAccion")?.classList.contains("con-ficha"))return false;
  g.fragmentos++;
  guiaDijo(txt);
  guiaDecir("Elegí una opción y te ayudo al toque. Si preferís, te paso con una persona.");
  guiaReponerMenu();
  return true;
}
function guiaTrasTexto(){
  const g=guiaCargar();
  g.esperaTexto=false;
  if(g.humano||guiaPersonaAvisada())return guiaGuardar();
  g.personaAt=Date.now();guiaGuardar();
  guiaDecir("Listo, ya le llegó a una persona. Te contesta por acá mismo.");
  if(!$("guiaAccion")?.classList.contains("con-ficha"))guiaOfrecer([],{sinPersona:true});
}
function guiaOtraCosa(){
  const g=guiaCargar();
  g.tema=GUIA_TEMAS.consulta;g.esperaTexto=true;
  guiaDecir("Contame qué pasó y se lo paso a una persona.");
  guiaOfrecer([],{sinPersona:true});
}

// ── Quién es ─────────────────────────────────────────────────────────────────
function guiaPedirIdentidad(siguiente,texto){
  const g=guiaCargar();
  if(g.ingreso&&$("guiaEnviar")){g.ingreso.siguiente=siguiente;return;}
  g.ingreso={modo:"login",siguiente};
  guiaDecir(texto||"Primero decime quién sos, así veo tu cuenta 👇");
  guiaFichaIngreso();
}
function guiaAbrirIngreso(modo){
  guiaCargar().ingreso={modo,siguiente:()=>guiaIr("inicio")};
  guiaFichaIngreso();
}
function guiaModoIngreso(modo){
  const g=guiaCargar();
  if(_enviando||!g.ingreso)return;
  // No es otra ficha: sale de la ficha y sigue el mismo camino que la opción del menú.
  if(modo==="olvido"){
    if(guiaOcupada)return;
    g.ingreso=null;guiaDijo("No me acuerdo el usuario");
    return guiaCorrer(guiaOlvideUsuario);
  }
  if(!guiaTiene(GUIA_INGRESO,modo))return;
  g.ingreso.modo=modo;
  guiaFichaIngreso();
}
function guiaFichaIngreso(){
  const modo=guiaCargar().ingreso?.modo||"login",d=GUIA_INGRESO[modo];
  const enlace=(m,t)=>'<button type="button" onclick="guiaModoIngreso(\''+m+'\')">'+t+'</button>';
  guiaFicha('<form class="guia-ficha" novalidate onsubmit="event.preventDefault();guiaEnviarIngreso()"><h4>'+d.titulo+'</h4>'
    +(d.usuario?'<label for="guiaUsuario">'+d.usuario+'</label><input id="guiaUsuario" placeholder="'+d.ejemplo+'" value="'+esc(state.usuario||"")+'" autocomplete="username">':'')
    +'<label for="guiaTelefono">Tu teléfono, con código de área</label><input id="guiaTelefono" placeholder="Ej: 11 2345 6789" inputmode="tel" autocomplete="tel" value="'+esc(state.telefono||"")+'">'
    +'<div id="guiaError" class="guia-error" role="alert"></div>'
    +'<button type="submit" id="guiaEnviar" class="action-btn">'+d.boton+'</button>'
    +'<div class="guia-enlaces">'+(modo==="login"||modo==="validar"?enlace("olvido","No me acuerdo el usuario")+enlace("registro","Soy nuevo"):enlace("login","Ya tengo usuario"))+'</div></form>',[],{sinPersona:true});
}
async function guiaEnviarIngreso(){
  const g=guiaCargar(),modo=g.ingreso?.modo||"login",boton=GUIA_INGRESO[modo].boton;
  if(!_tomarEnvio("guiaEnviar","Un momento..."))return;
  const siguiente=g.ingreso?.siguiente;
  let aviso="";
  try{
    const usuario=$("guiaUsuario")?.value||"",telefono=$("guiaTelefono")?.value||"";
    const entra=modo==="login"||modo==="validar";
    const r=entra?await ingresarJugador(usuario,telefono):pedirRegistroCon(usuario,telefono);
    if(r.error)return guiaErrorFicha(r.error);
    if(entra&&r.acceso){
      guiaQuitarAccion();
      guiaDecir("Listo, <b>"+esc(state.usuario)+"</b>, ya te reconocí.");
    }else aviso=entra?"validar":"registro";
    g.ingreso=null;guiaGuardar();
    startChatPoll();
  }catch(e){
    console.warn("[asistente]",e);
    return guiaErrorFicha("No pude entrar ahora. Probá de nuevo.");
  }finally{_soltarEnvio("guiaEnviar",boton,true);}
  if(!aviso)return guiaCorrer(siguiente||(()=>guiaIr("inicio")));
  // Si había escrito algo a mano, sale igual después de avisar.
  return guiaCorrer(async()=>{
    await guiaAvisarPersona(aviso);
    if(siguiente===sendFreeMessage)await sendFreeMessage();
  });
}
// No se pudo validar solo: va al mismo canal de siempre, con los datos que ya dejó. El operador
// lo revisa y le aparece el botón Ingresar acá mismo.
async function guiaAvisarPersona(tipo){
  const g=guiaCargar(),r=await enviarAltaSoporte(tipo,g.tema);
  if(!r?.ok)return guiaFalloEnvio(tipo);
