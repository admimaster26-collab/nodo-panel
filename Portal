    +'<div style="font-size:13px;font-weight:800;color:#fca5a5;margin-bottom:5px">🚫 Tu '+(tipo==="RETIRO"?"retiro":"carga")+' anterior no se pudo procesar</div>'
    +'<div style="font-size:12.5px;color:#e8c9c9;line-height:1.45">'+esc(r.motivo)+'</div>'
