// Con ?prueba=p1 el portal apunta a la oficina P1 y NO se muda al dominio propio.
// Sin esto, cualquier copia subida a otro enlace resuelve la ruta, ve que el host de la
// agencia es otro y hace location.replace() al portal de producción: nunca llegás a probar
// el tuyo. Ver el bloque "Si llegaron por el dominio genérico" acá abajo.
// Se activa SOLO con el parámetro en la URL: sin él, el portal se comporta igual que siempre.
const RUTAS_PRUEBA = { p1:"rt-a8f31", p2:"rt-k6d92", p3:"rt-m4q77", p4:"rt-z9p42",
                       p5:"rt-x2v61", p6:"rt-r5023", p7:"rt-m2z3r" };
const MODO_PRUEBA = (function(){
  try{
    const v = (new URLSearchParams(location.search).get("prueba")||"").trim().toLowerCase();
    if(v && RUTAS_PRUEBA[v]) return { oficina:v.toUpperCase(), ruta:RUTAS_PRUEBA[v] };
    // En una copia de pruebas (GitHub Pages / archivo local) va derecho a P1 sin pedir nada.
    // El chequeo es por HOST y no puede activarse en produccion: los dominios reales terminan
    // en portal-bet-300.com, que nunca matchea con esto.
    const h = String(location.hostname||"").toLowerCase();
    const esCopiaDePrueba = h.endsWith(".github.io") || h==="localhost" || h==="127.0.0.1" || h==="";
    if(esCopiaDePrueba) return { oficina:"P1", ruta:RUTAS_PRUEBA.p1 };
    return null;
  }catch(_e){ return null; }
})();
if(MODO_PRUEBA){
