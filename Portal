async function pintarHistorialUsuario(){
  const box=_histBox(); if(!box) return;
  box.innerHTML='<div style="text-align:center;color:#8b95a5;font-size:12px;padding:10px">Cargando historial…</div>';
  const resumen=await cargarResumenHistorial();
