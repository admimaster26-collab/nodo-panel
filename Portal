    toast("⚠️ Tu usuario no está habilitado para operar. Validá tus datos o escribinos por soporte."); goChat(); return;
  }
  if(!r.ok){
    _restaurarBoton("btnEnviarRetiro","Enviar retiro a revisión");
    if(r.mensaje){toast(r.mensaje);return;}
    if(r.motivo==="protocolo_no_disponible"||r.motivo==="beta_error"||r.motivo==="beta_respuesta_invalida"){toast("No pudimos confirmar el retiro con el servidor. No se envió; probá de nuevo en unos minutos.");return;}
    toast("No pudimos enviar el retiro. Probá por el chat.");goChat();return;
  }
  if(r.porChat){
    toast("Lo tomamos por el chat · un operador lo confirma");
    haptic([20,30,20]);
    renderHome();
    goChat();
    startChatPoll();
    startPortalThreadPoll();
    setTimeout(()=>subscribePush(),1200);
    return;
  }
  toast(r.estadoValidacion==="PENDIENTE"?"Retiro recibido · verificamos esta cuenta por única vez y te avisamos por el chat.":"Retiro enviado a revisión 🕓");haptic([20,30,20]);
  renderHome();
  goEstado();
  startChatPoll();
  setTimeout(()=>startEstadoPoll(),8000);
  setTimeout(()=>subscribePush(),1200);
  } finally {
    _soltarEnvio("btnEnviarRetiro","Enviar retiro a revisión");
  }
}

