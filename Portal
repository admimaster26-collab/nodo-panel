// Crea la carga y devuelve qué pasó. Lo que se muestra después lo decide quien la pidió: la
// pantalla Cargar o la ficha del chat. Es la única función del Portal que crea cargas.
async function crearSolicitudCarga(usuario,monto,titular,conservarChat){
  limpiarSolicitudAnteriorAntesDeNueva(conservarChat);
  const bp=billeteraPayloadPlano();
  const _ip=await _ipPublica();   // si no llega en 2,5 s va sin ella: nunca frena el envío
  const payload={usuario,monto:Number(monto),titular,telefono:state.telefono||"",pc_codigo:state.pcCodigo,public_code:state.publicCode,host:location.host,navegador:_infoNavegador(),ip:_ip||"",tipo:"CARGA",...bp,..._marcaDeTiempo()};
  const destino=bp.billetera_nombre?`${bp.billetera_nombre}${bp.billetera_alias?" · "+bp.billetera_alias:""}`:null;
  let res=await rpc("landing_portal_v16_crear_solicitud",{p_public_code:state.publicCode,p_usuario:usuario,p_tipo:"CARGA",p_monto:Number(monto),p_titular:titular,p_destino:destino,p_mensaje:"Solicitud de CARGA: $"+monto+" · Titular: "+titular,p_metadata:payload});
  // Rechazo por validación de vínculo → NO usar fallback (sería un bypass). Mandamos a soporte.
  if(res.error && /VINCULO_NO_VALIDO|NO_AUTORIZADO|NO_REGISTRADO|CONFLICTO|BLOQUEADO/i.test(res.error.message||""))return {ok:false,motivo:"no_habilitado"};
  if(res.error){console.warn("[V18]",res.error);res=await rpc("landing_crear_solicitud_v3_blindado",{p_public_code:state.publicCode,p_usuario:usuario,p_tipo:"CARGA",p_monto:Number(monto),p_titular:titular,p_comprobante_url:null,p_extra:payload});}
  if(res.error){res=await rpc("landing_crear_chat_v2_blindado",{p_public_code:state.publicCode,p_usuario:usuario,p_mensaje:"Solicitud de CARGA: $"+monto+" · Titular: "+titular,p_tipo:"CARGA",p_extra:payload});}
  if(res.error)return {ok:false,motivo:"sin_envio"};
  const data=normalize(res.data)||res.data||{};
  const solicitudId=data?.solicitud_id||data?.id||data?.solicitudId||"";
  const chatId=data?.chat_id||data?.chatId||"";
  const chatToken=data?.chat_token||data?.chatToken||"";
  if(chatId){state.chatId=String(chatId);localStorage.setItem("bet300_chat_id",state.chatId);}
  if(chatToken){state.chatToken=String(chatToken);localStorage.setItem("bet300_chat_token",state.chatToken);}
  // Sin nº de solicitud REAL no se marca nada como pendiente. Los dos fallbacks de arriba pueden
  // terminar creando sólo un chat (landing_crear_chat_v2_blindado no crea solicitud), y antes se
  // guardaba igual el pendiente con id vacío: el portal quedaba trabado —"Ya tenés una solicitud
  // en revisión" bloqueaba toda carga y todo retiro nuevo— sin nada que consultar para destrabarlo.
  // La única salida era "Marcar como resuelta en este dispositivo", que casi nadie encuentra.
  if(!/^\d+$/.test(String(solicitudId||"")))return {ok:true,porChat:true};
  // Se guarda el TITULAR de la cuenta, que es lo que la persona vio y reconoce. "SALVATIERRA X"
  // es como le decimos nosotros adentro y no le dice nada a nadie.
  setPendiente("CARGA",String(solicitudId),(bp&&bp.billetera_titular)||destino||"");
  _guardarTitularPrevio(titular);   // la próxima vez viene pre-rellenado
  return {ok:true,solicitudId:String(solicitudId)};
}
async function enviarSolicitudCarga(usuario,monto,titular){
  if(!await _puedeOperarConServidor())return;
  if(!(Number(monto)>0))return toast("Ingresá un monto válido.");
  if(Number(monto)<_minCarga())return toast("La carga mínima es "+_money(_minCarga())+".");
  if(String(titular||"").trim().length<3)return toast("Indicá el titular que transfiere (mínimo 3 letras).");
  const r=await crearSolicitudCarga(usuario,monto,titular);
  if(r.motivo==="no_habilitado"){
    toast("⚠️ Tu usuario no está habilitado para operar. Validá tus datos o escribinos por soporte."); goChat(); return;
  }
  if(!r.ok){toast("No pudimos enviar la solicitud. Probá por el chat.");goChat();return;}
  if(r.porChat){
    toast("Lo tomamos por el chat · un operador lo confirma");
    haptic([20,30,20]);
    renderHome();
    goChat();
    startChatPoll();
    startPortalThreadPoll();
    setTimeout(()=>subscribePush(),1200);
    return;
  }
  toast("Solicitud enviada ✅");haptic([20,30,20]);
  renderHome();
  goEstado();
  startChatPoll();
  setTimeout(()=>startEstadoPoll(),8000);
  setTimeout(()=>subscribePush(),1200);
}

