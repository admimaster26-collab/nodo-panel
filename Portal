// TITULAR · criterios de entrada
// El titular es el dato que más se ensucia y el que más rechazos genera. Tres
// familias de basura, en orden de frecuencia:
//   1. Caracteres que no son un nombre: números, puntos, comas, guiones, el CBU
//      pegado, emojis. Se sacan MIENTRAS ESCRIBE, no al enviar: así no llega
//      nunca a mandarlo y no hay que rechazarlo después.
//   2. NUESTROS propios datos. La cuenta a la que transfieren está 60px más
//      arriba en la misma pantalla; se copia el titular/alias/CBU de ahí y se
//      pega acá. Eso se corta antes de enviar.
//   3. El propio usuario de plataforma como titular ("mi usuario es juanok12,
//      pongo juanok12"). No es un nombre real y el cotejo nunca cierra.
// ══════════════════════════════════════════════════════════════════════════
const TITULAR_MIN_LETRAS=3;

// Deja SOLO letras (con acentos y ñ) y espacios simples. Todo lo demás se cae:
// dígitos, punto, coma, guion, barra, símbolos. Un nombre no lleva nada de eso.
function _soloLetras(v){
  return String(v||"")
    .replace(/[^\p{L}\s]/gu,"")   // fuera todo lo que no sea letra o espacio
    .replace(/\s{2,}/g," ")       // espacios repetidos → uno
    .replace(/^\s+/,"");          // sin espacio al principio (el del final se deja: está tipeando)
}
// Normaliza para COMPARAR (no para mostrar): minúsculas, sin acentos, sin nada
// que no sea letra o número. Así "JUAN.PEREZ" y "juan perez" son lo mismo.
function _normComparar(v){
  return String(v||"").toLowerCase().normalize("NFD")
    .replace(/[̀-ͯ]/g,"").replace(/[^a-z0-9]/g,"");
}
// Los datos de NUESTRA billetera, normalizados, para detectar que los copiaron.
function _datosPropiosNormalizados(){
  const b=state.billetera||{};
  return [b.titular,b.alias,b.cbu,b.cvu,b.nombre_visible,b.nombre]
    .map(_normComparar).filter(function(x){ return x && x.length>=4; });
}
// Devuelve "" si está bien, o el motivo por el que no se puede enviar.
function validarTitular(valor){
  const v=String(valor||"").trim();
  const letras=v.replace(/[^\p{L}]/gu,"");
  if(letras.length<TITULAR_MIN_LETRAS) return "Escribí el nombre y apellido de la cuenta desde la que transferiste.";
  const n=_normComparar(v);
  // Alias o CBU nuestro escrito en el campo del titular: se equivocó de campo, se avisa.
  for(const p of _identificadoresPropios()){
    if(n===p || n.indexOf(p)>=0 || (n.length>=8 && p.indexOf(n)>=0)){
      return "Ese es el titular de NUESTRA cuenta. Poné el nombre de la cuenta desde la que vos transferiste.";
    }
  }
  // Nombres: sólo si escribió EXACTAMENTE el nuestro. Compartir un apellido no es un error.
  for(const p of _nombresPropios()){
    if(n===p){
      return "Ese es el titular de NUESTRA cuenta. Poné el nombre de la cuenta desde la que vos transferiste.";
    }
  }
  // Esto trababa cargas de gente real (Juan, 3/10). La regla era: si el usuario aparece EN
  // CUALQUIER PARTE del titular, rechazar. Pero muchísimos jugadores usan su propio nombre como
  // usuario — así que el titular de su cuenta bancaria contiene el usuario casi siempre.
  // "Yamila Muhamad" con usuario "yamila2024" quedaba trabada, y sin forma de salir: no hay nada
  // que pueda escribir, porque ESE es el nombre de su cuenta.
  //
  // Lo que se quiere evitar es que ponga su usuario de juego en vez del titular. Y eso se nota
  // por otra cosa: un nombre y apellido son DOS palabras; un usuario es una sola. Si escribió dos
  // o más palabras, es un nombre — no se toca, aunque contenga el usuario.
  const _palabras = v.split(/\s+/).filter(Boolean);
  if(_palabras.length < 2){
    const _uNorm=_normComparar(state.usuario||"");
    const _uLetras=String(state.usuario||"").replace(/[^\p{L}]/gu,"").toLowerCase()
      .normalize("NFD").replace(/[̀-ͯ]/g,"");
    for(const u of [_uNorm,_uLetras]){
      if(!u || u.length<3) continue;
      if(n===u || (u.length>=4 && n.indexOf(u)>=0)){
        return "Ese es tu usuario de juego, no el titular. Poné el nombre y apellido de la cuenta bancaria.";
      }
    }
  }
  return "";
}
// Sanea el campo mientras escribe y avisa en el momento si copió algo que no va.
// Titulares bloqueados. El operador los marca desde el panel y hasta ahora eso quedaba en el
// localStorage DE ESA PC: el portal no se enteraba nunca y le seguía ofreciendo al jugador el
// mismo titular que le acababan de bloquear. Ahora se consulta a la base.
// Se pregunta ANTES de crear la solicitud: rechazarla después es hacerle perder el viaje y
// sumar un rechazo más a la pila.
// El titular tiene que ser el de la cuenta DESDE LA QUE transfirió, no el de la nuestra.
// Copiar el nombre de nuestra billetera es el error más común y termina en un rechazo por
// DATO_PROPIO: el jugador pierde el viaje y el operador pierde el tiempo. Los datos de la
// billetera los tenemos acá mismo, así que se corta antes de mandar.
function _titularEsNuestro(titular){
  const t = _normComparar(titular);
  if(t.length < 3) return false;
  const porIdentificador = _identificadoresPropios()
    .some(function(v){ return t === v || t.indexOf(v) !== -1 || (t.length >= 8 && v.indexOf(t) !== -1); });
  if(porIdentificador) return true;
  return _nombresPropios().some(function(v){ return v === t; });
}

async function _titularBloqueado(titular){
  const t = String(titular||"").trim();
  if(!t || !state.usuario) return null;
  try{
    const r = await rpc("landing_titular_bloqueado", {
      p_usuario: state.usuario, p_titular: t, p_public_code: state.publicCode||""
    });
    if(r.error) return null;                 // sin respuesta no se traba a nadie
    const d = normalize(r.data) || (Array.isArray(r.data) ? r.data[0] : r.data) || {};
    return d && d.bloqueado === true ? d : null;
  }catch(_e){ return null; }
}

function onTitularInput(el){

  if(!el) return;
