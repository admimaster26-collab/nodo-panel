    _titularAviso(el,_malTR);
    haptic(18);
    return toast("Revisá el titular");
  }
  const protocolo=await _consultarRetiroProtocolo(false);
  const instrumento=protocolo.instrumento||null;
  const requiereDni=protocolo.mode==="beta"&&(!(instrumento
    &&String(instrumento.destino||"").trim().toUpperCase()===String(destino||"").trim().replace(/\s+/g,"").toUpperCase()
    &&String(instrumento.titular||"").trim().toUpperCase()===String(titular||"").trim().replace(/\s+/g," ").toUpperCase())
    ||!!protocolo.cambiarCuenta);
  if(protocolo.mode==="error")return toast("No pudimos comprobar la verificación de retiro. Probá de nuevo en unos minutos.");
  if(requiereDni&&!/^\d{8}$/.test(dni)){ $("retiroDni")?.focus(); return toast("Ingresá el DNI de 8 dígitos del titular de la cuenta."); }
  const btn=$("btnEnviarRetiro");
  if(btn){btn.disabled=true;btn.textContent="Enviando...";}
