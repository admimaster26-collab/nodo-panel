  let html='<div style="width:100%;font-size:12px;line-height:1.6;color:#c9d3e0">Pediste <b>'+_money(Number(r.monto)||0)+'</b>';
  if(r.monto_a_pagar!=null && Number(r.monto_a_pagar)!==Number(r.monto))html+=' · a pagar <b>'+_money(Number(r.monto_a_pagar)||0)+'</b>';
  if(r.motivo_ajuste)html+='<br>'+esc(r.motivo_ajuste);
  if(Number(r.pagado)>0)html+='<br>Ya te pagamos <b>'+_money(Number(r.pagado))+'</b>';
  if(Array.isArray(pagos))for(const p of pagos){
    html+='<br>'+esc(_fechaCorta(p.fecha))+' · '+_money(Number(p.monto)||0)+(p.desde?' · te transfirió '+esc(p.desde):'');
  }
  if(cierre && typeof cierre==='object')html+='<br><b>Se cerró: '+esc(cierre.etiqueta||'Retiro cerrado')+'</b>'+(cierre.nota?' · '+esc(cierre.nota):'');
  return html+'</div>';
