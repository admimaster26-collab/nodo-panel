// Crea el retiro y devuelve qué pasó. Es la única función del Portal que crea retiros: la usan la
// pantalla Retirar y la ficha del chat.
async function crearSolicitudRetiro(usuario,monto,destino,titular,conservarChat,dni){
  const msg="Solicitud de RETIRO: $"+monto+" · Destino: "+destino+" · Titular: "+titular;
  const _ipR=await _ipPublica();
  const payload={usuario,monto,destino,titular,telefono:state.telefono||"",pc_codigo:state.pcCodigo,public_code:state.publicCode,host:location.host,navegador:_infoNavegador(),ip:_ipR||"",tipo:"RETIRO",..._marcaDeTiempo()};
  const protocolo=await _consultarRetiroProtocolo(false);
  if(protocolo.mode==="error")return {ok:false,motivo:"protocolo_no_disponible"};
  let dataR=null;
  if(protocolo.mode==="beta"){
    const instrumento=protocolo.instrumento||null;
    const requiereDni=!(instrumento&&String(instrumento.destino||"").trim().toUpperCase()===String(destino||"").trim().replace(/\s+/g,"").toUpperCase()
      &&String(instrumento.titular||"").trim().toUpperCase()===String(titular||"").trim().replace(/\s+/g," ").toUpperCase())
      ||!!protocolo.cambiarCuenta;
    const dniLimpio=String(dni||"").replace(/\D/g,"");
    if(requiereDni&& !/^\d{8}$/.test(dniLimpio))return {ok:false,motivo:"dni_requerido"};
    const beta=await rpc("landing_portal_retiro_crear_v1",{
      p_public_code:state.publicCode||"",p_usuario:usuario,p_telefono:state.telefono||"",
      p_host:location.host||"",p_monto:monto,p_titular:titular,p_destino:destino,
      p_dni:requiereDni?dniLimpio:null,p_metadata:payload
    });
    if(beta.error)return {ok:false,motivo:"beta_error"};
    dataR=normalize(beta.data)||beta.data||{};
    if(dataR.error_code){
      const motivos={DNI_REQUERIDO:"Ingresá el DNI de 8 dígitos del titular.",
        DNI_RECHAZADO_PREVIAMENTE:"Ese DNI ya fue rechazado. Ingresá el DNI correcto del titular de la cuenta.",
        RETIRO_EN_VALIDACION:"Esta cuenta ya tiene un retiro en verificación. Esperá el aviso antes de enviar otro."};
      return {ok:false,motivo:"beta_validacion",mensaje:motivos[dataR.error_code]||"No pudimos registrar la cuenta de cobro."};
    }
    if(dataR.ok!==true||dataR.contract!=="retiro.instrumentos.v1"||dataR.enabled!==true
       ||!/^\d+$/.test(String(dataR.solicitud_id||"")))return {ok:false,motivo:"beta_respuesta_invalida"};
  }else{
    let res=await rpc("landing_portal_v16_crear_solicitud",{
      p_public_code:state.publicCode,p_usuario:usuario,p_tipo:"RETIRO",
      p_monto:monto,p_titular:titular,p_destino:destino,p_mensaje:msg,p_metadata:payload
    });
    if(res.error&&/VINCULO_NO_VALIDO|NO_AUTORIZADO|NO_REGISTRADO|CONFLICTO|BLOQUEADO/i.test(res.error.message||""))return {ok:false,motivo:"no_habilitado"};
    if(res.error){
      console.warn("[V18] retiro v16 falló",res.error);
      res=await rpc("landing_crear_solicitud_v3_blindado",{
        p_public_code:state.publicCode,p_usuario:usuario,p_tipo:"RETIRO",
        p_monto:monto,p_titular:titular,p_comprobante_url:null,p_extra:payload
      });
    }
    if(res.error){
      res=await rpc("landing_crear_chat_v2_blindado",{
        p_public_code:state.publicCode,p_usuario:usuario,p_mensaje:msg,p_tipo:"RETIRO",p_extra:payload
      });
    }
    if(res.error)return {ok:false,motivo:"sin_envio"};
    dataR=normalize(res.data)||res.data||{};
  }
  limpiarSolicitudAnteriorAntesDeNueva(conservarChat);
  const solicitudId=dataR?.solicitud_id||dataR?.id||dataR?.solicitudId||"";
  const chatId=dataR?.chat_id||dataR?.chatId||"";
  const chatToken=dataR?.chat_token||dataR?.chatToken||"";
  if(chatId){state.chatId=String(chatId);localStorage.setItem("bet300_chat_id",state.chatId);}
  if(chatToken){state.chatToken=String(chatToken);localStorage.setItem("bet300_chat_token",state.chatToken);}
  if(!/^\d+$/.test(String(solicitudId||"")))return {ok:true,porChat:true};
  setPendiente("RETIRO",String(solicitudId));
  state._retiroPendienteValidacion=dataR.estado_validacion==="PENDIENTE";
  state._retiroDniRechazado=false;
  try{localStorage.setItem(_retiroKey(),String(Date.now()));}catch(_e){} // arranca el cooldown de 24h (1 retiro/día)
  if(state._retiroProtocolo){state._retiroProtocolo.cambiarCuenta=false;state._retiroProtocolo.correccion=false;}
  state._retiroProtocoloCache=null;
  return {ok:true,solicitudId:String(solicitudId),estadoValidacion:dataR.estado_validacion||"LEGACY"};
}

async function enviarSolicitudRetiro(){
  if(!_tomarEnvio("btnEnviarRetiro")) return;
  try{
  _marcarToque();
  if(!await _puedeOperarConServidor())return;
  const restRet=retiroCooldownRestanteMs();
  if(restRet>0)return toast("Ya solicitaste un retiro hoy. Podés pedir otro en "+_fmtRestante(restRet)+".");
  const usuario=state.usuario,montoRaw=$("retiroMonto")?.value.trim(),destino=$("retiroDestino")?.value.trim(),titular=$("retiroTitular")?.value.trim();
  const dni=String($("retiroDni")?.value||"").replace(/\D/g,"");
  if(marcarFaltantes(["retiroMonto","retiroDestino","retiroTitular"])) return toast("Falta completar el campo marcado");
  const monto=Math.abs(Number(montoRaw));
  if(!monto||monto<=0)return toast("Ingresá un monto válido mayor a cero");
  if(monto<_minRetiro())return toast("El retiro mínimo es "+_money(_minRetiro())+".");
  if(String(destino).trim().length<6)return toast("El alias/CBU de destino es muy corto.");
  const _malTR=validarTitular(titular);
