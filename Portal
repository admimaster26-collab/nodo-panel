  const verdict=String(d.verdict||"").toUpperCase();
  if(VINCULO_OPERA.includes(verdict)){
    const estado=String(d.estado||"").toUpperCase();
    _vinculoOk={usuario:state.usuario,telefono:state.telefono,verdict,estado,at:Date.now()};
