// ── Enlace de acceso (?t=) ─────────────────────────────────────────────────
// El operador verifica a la persona en el CRM y recién ahí le manda por WhatsApp un enlace
// que la deja adentro YA VALIDADA y en la pantalla que corresponde (cargar o retirar), sin
// pedirle usuario ni teléfono. No se reparten sueltos: cada uno vale para un solo uso y vence.
//
// Si vuelven a tocar el mismo enlace más tarde (pasa: la gente reabre el mensaje de WhatsApp)
// el canje falla con YA_USADO, pero la sesión quedó guardada en el teléfono → entran igual y
// NO les mostramos ningún error. El aviso sale solo si además no tienen sesión.
async function canjearEnlaceAcceso(){
  const t=(new URLSearchParams(location.search).get("t")||"").trim();
  if(!t) return null;

  try{
    const u=new URL(location.href); u.searchParams.delete("t");
    history.replaceState(null,"",u.pathname+(u.search||"")+(u.hash||""));
  }catch(_e){}

  let d=null;
  try{ const r=await rpc("landing_acceso_link_usar",{p_token:t}); d=normalize(r.data)||r.data||null; }catch(_e){}

  if(!d||!d.ok){
    if(state.usuario) return null;              // ya estaba adentro: el enlace sobraba
    const motivo=String((d&&d.motivo)||"");
    toast(motivo==="VENCIDO"||motivo==="YA_USADO"
      ? "Este enlace ya se usó o venció. Pedile uno nuevo al operador."
      : "No pudimos validar el enlace. Escribinos por chat y te ayudamos.");
    return null;
  }

  state.usuario=String(d.usuario||"");
  state.telefono=String(d.telefono||"");
  state.pcCodigo=d.pc_codigo||state.pcCodigo;
  if(d.public_code){ _fijarOficina(d.public_code); }
  state.nivelAcceso="OK"; state.motivoSoporte="";
  try{
    localStorage.setItem("bet300_usuario",state.usuario);
    localStorage.setItem("bet300_telefono",state.telefono);
    localStorage.setItem("bet300_nivel_acceso","OK");
    localStorage.removeItem("bet300_motivo_soporte");
  }catch(_e){}
  setTimeout(()=>subscribePush(),1500);
  setTimeout(()=>marcarAppInstalada(),1700);
  return { destino:String(d.destino||"").toUpperCase() };
}

