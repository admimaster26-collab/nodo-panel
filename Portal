// El chat se guarda en dos lados: la tabla nueva y una copia en el hilo de la solicitud, que es lo
// único que leen los NODO sin actualizar. Una solicitud vive en un solo lugar y por eso nunca se
// duplica. Cuando el servidor avisa que el NODO de esta oficina anda por el canal nuevo, igual que
// avisa cuál es la billetera activa, el mensaje ya viene en rows y su copia sobra. Lo que existe
// sólo en el hilo (lo que el operador manda por el camino viejo) sigue saliendo.
function portalChatSinCopias(hilo,filas){
  const segundo=v=>{const t=Date.parse(String(v||'').slice(0,19)+'Z');return Number.isFinite(t)?t/1000:null;};
  const lado=m=>(chatMessageRole(m)==='user'?'U|':'O|')+String(m.mensaje??'').trim();
  const ya=new Map();
  for(const f of filas){const s=segundo(f.created_at);if(s!==null)ya.set(lado(f),(ya.get(lado(f))||[]).concat(s));}
  return hilo.filter(m=>{const s=segundo(m.fecha);return !(s!==null&&(ya.get(lado(m))||[]).some(x=>Math.abs(x-s)<=10));});
