// Navegador + SO + si es PWA → se manda en la metadata de la solicitud para que el operador lo vea.
// ── IP pública de quien manda la solicitud ────────────────────────────────
// No la sabe el navegador: hay que preguntársela a un servicio de afuera. Se pide UNA vez por
// sesión y se cachea; si falla o tarda, la solicitud sale igual sin IP — esto nunca puede ser
// motivo de que una carga no se envíe.
//
// Para qué sirve: no da la dirección exacta, pero dice de qué tipo de conexión entra la gente
// y, sobre todo, permite ver VARIAS CUENTAS DESDE LA MISMA CASA — que es otra forma de agarrar
// a los que cazan bonos con cuentas distintas.
//
// Ojo con leer de más: en una red móvil o en un barrio con CGNAT muchos vecinos comparten la
// misma IP pública. Coincidir NO prueba que sean la misma persona; es una señal para mirar,
// no una condena.
let _ipCache=null, _ipPedida=false;
async function _ipPublica(){
  if(_ipCache!==null) return _ipCache;
  if(_ipPedida) return null;              // ya hay una en vuelo: no encolar otra
  _ipPedida=true;
  try{
    const ctrl=new AbortController();
    const t=setTimeout(function(){ ctrl.abort(); }, 2500);   // no bloquear el envío
    const r=await fetch("https://api.ipify.org?format=json",{signal:ctrl.signal});
    clearTimeout(t);
    const d=await r.json();
    _ipCache=String((d&&d.ip)||"")||null;
  }catch(_e){ _ipCache=null; }
  return _ipCache;
}

